@namespace KppBlazor.Layout.MainLayout
@inherits LayoutComponentBase
@using KppBlazor.Services
@using KppBlazor.Shared
@using KppBlazor.Pages
@inject AppState State
@implements IDisposable

@if (State.Auth == null)
{
    <Login />
}
else
{
    <div id="app-root" class="@(sidebarOpen ? "sidebar-is-open" : "")">

        <!-- Overlay для мобильных -->
        @if (sidebarOpen)
        {
            <div class="sidebar-overlay" @onclick="CloseSidebar"></div>
        }

        <Sidebar OnClose="CloseSidebar" />

        <main id="main">
            <!-- Гамбургер (только на мобильных, управляется CSS) -->
            <button class="btn-hamburger" @onclick="ToggleSidebar" title="Меню">
                <span></span><span></span><span></span>
            </button>

            @switch (State.CurrentView)
            {
                case "history":
                    <History />
                    break;
                case "register":
                    <Register />
                    break;
                case "users":
                    <Users />
                    break;
                case "roles":
                    <Roles />
                    break;
                default:
                    <History />
                    break;
            }
        </main>
    </div>
}

@code {
    bool sidebarOpen = false;

    protected override void OnInitialized()
    {
        State.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        State.OnChange -= StateHasChanged;
    }

    void ToggleSidebar() => sidebarOpen = !sidebarOpen;
    void CloseSidebar()  => sidebarOpen = false;
}
