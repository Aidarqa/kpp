@namespace KppBlazor.Layout.MainLayout
@inherits LayoutComponentBase
@using KppBlazor.Services
@using KppBlazor.Shared
@using KppBlazor.Pages
@inject AppState State
@inject ThemeService Theme
@inject LocalizationService Loc
@implements IDisposable

@if (State.Auth == null)
{
    <Login />
}
else
{
    <div id="app-root" class="@(sidebarOpen ? "sidebar-is-open" : "")">

        <!-- Overlay для мобильных -->
        @if (sidebarOpen)
        {
            <div class="sidebar-overlay" @onclick="CloseSidebar"></div>
        }

        <Sidebar OnClose="CloseSidebar" />

        <main id="main">
            <!-- Top-right controls: language + theme -->
            <div class="top-controls">
                <div class="lang-picker">
                    <button class="lang-btn @(Loc.CurrentLang == "ru" ? "active" : "")"
                            @onclick='async () => await Loc.SetLangAsync("ru")'>RU</button>
                    <button class="lang-btn @(Loc.CurrentLang == "ky" ? "active" : "")"
                            @onclick='async () => await Loc.SetLangAsync("ky")'>KG</button>
                    <button class="lang-btn @(Loc.CurrentLang == "en" ? "active" : "")"
                            @onclick='async () => await Loc.SetLangAsync("en")'>EN</button>
                </div>
                <button class="btn-mode-toggle-header" @onclick="async () => await Theme.ToggleAsync()"
                        title='@(Theme.IsDark ? Loc["theme.light"] : Loc["theme.dark"])'>
                    @if (Theme.IsDark)
                    {
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
                        </svg>
                    }
                    else
                    {
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
                        </svg>
                    }
                </button>
            </div>

            <!-- Гамбургер (только на мобильных, управляется CSS) -->
            <button class="btn-hamburger" @onclick="ToggleSidebar" title="Меню">
                <span></span><span></span><span></span>
            </button>

            @switch (State.CurrentView)
            {
                case "dashboard":
                    <Dashboard />
                    break;
                case "history":
                    <History />
                    break;
                case "register":
                    <Register />
                    break;
                case "users":
                    <Users />
                    break;
                case "roles":
                    <Roles />
                    break;
                default:
                    <Dashboard />
                    break;
            }
        </main>
    </div>
}

@code {
    bool sidebarOpen = false;

    protected override void OnInitialized()
    {
        State.OnChange += StateHasChanged;
        Theme.OnChange += StateHasChanged;
        Loc.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        State.OnChange -= StateHasChanged;
        Theme.OnChange -= StateHasChanged;
        Loc.OnChange -= StateHasChanged;
    }

    void ToggleSidebar() => sidebarOpen = !sidebarOpen;
    void CloseSidebar()  => sidebarOpen = false;
}
