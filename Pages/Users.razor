
@page "/admin/users"
@using KppBlazor.Services
@using KppBlazor.Models
@inject ApiService Api
@inject AppState State
@inject LocalizationService Loc
@implements IDisposable

<div class="page-fill">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;flex-wrap:wrap;gap:12px">
        <div style="display:flex;align-items:center;gap:14px">
            <div class="page-title-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                    <circle cx="9" cy="7" r="4"/>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                </svg>
            </div>
            <div class="page-title" style="margin:0">@Loc["users.title"]</div>
        </div>
        <button class="btn-primary" @onclick="ToggleCreate">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            @Loc["users.createUser"]
        </button>
    </div>

    @if (!string.IsNullOrEmpty(flashMsg))
    {
        <div class="msg-ok">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
            @flashMsg
        </div>
    }

    <div class="table-wrap table-fill">
        @if (loading)
        {
            <div class="loading">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="spin"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
                @Loc["history.loading"]
            </div>
        }
        else if (!string.IsNullOrEmpty(loadErr))
        {
            <div class="err-banner" style="margin:20px">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                @loadErr
            </div>
        }
        else
        {
            <table>
                <thead>
                    <tr>
                        @foreach (var h in new[] { Loc["users.user"], Loc["lbl.login"], Loc["lbl.role"], Loc["users.status"], Loc["users.created"], Loc["users.actions"] })
                        {
                            <th>@h</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in users)
                    {
                        <tr>
                            <td><div class="guest-name">@u.DisplayName</div></td>
                            <td><span style="color:var(--text-muted);font-family:'JetBrains Mono',monospace;font-size:12px">@u.Username</span></td>
                            <td>
                                <span class="role-tag">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/></svg>
                                    @u.RoleDisplayName
                                </span>
                            </td>
                            <td>
                                <span class="@(u.IsBlocked ? "badge-blocked" : "badge-active")">
                                    @(u.IsBlocked ? Loc["users.blocked"] : Loc["users.active"])
                                </span>
                            </td>
                            <td><span class="cell-sm">@IsoDate(u.CreatedAt)</span></td>
                            <td>
                                <div class="act-row">
                                    @if (resetId == u.Id)
                                    {
                                        <div class="pwd-row">
                                            <input class="pwd-inp" type="password" placeholder="@Loc["users.newPassword"]"
                                                   @bind="newPwd" @bind:event="oninput" />
                                            <button class="btn-sm btn-sm-green" @onclick="() => SavePwd(u.Id)" title="@Loc["btn.save"]">
                                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                                            </button>
                                            <button class="btn-sm" style="background:var(--surface-2);color:var(--text-dim);border:1px solid var(--border)"
                                                    @onclick="CancelReset" title="@Loc["btn.cancel"]">
                                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <button class="btn-sm btn-sm-blue" @onclick="() => StartReset(u.Id)">
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                                            @Loc["users.password"]
                                        </button>
                                    }
                                    @if (u.RoleName != RoleNames.Admin)
                                    {
                                        <button class="btn-sm @(u.IsBlocked ? "btn-sm-green" : "btn-sm-red")"
                                                @onclick="() => ToggleBlock(u)">
                                            @(u.IsBlocked ? Loc["users.unblock"] : Loc["users.block"])
                                        </button>
                                        <button class="btn-sm-del" @onclick="() => DeleteUser(u)" title="@Loc["btn.delete"]">
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<!-- Модалка создания пользователя -->
@if (showCreate)
{
    <div class="modal-bg" @onclick="() => showCreate = false">
        <div class="modal-box" style="max-width:480px" @onclick:stopPropagation="true">
            <div class="modal-hdr">
                <span class="modal-hdr-title">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg>
                    @Loc["users.newUser"]
                </span>
                <button class="modal-close" @onclick="() => showCreate = false">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>
            </div>

            <div class="form-grid" style="margin-bottom:16px">
                <div class="form-group">
                    <label class="lbl">@Loc["lbl.login"]</label>
                    <input class="input" placeholder="username" @bind="cf_username" @bind:event="oninput" />
                </div>
                <div class="form-group">
                    <label class="lbl">@Loc["lbl.password"]</label>
                    <input class="input" type="password" placeholder="••••••" @bind="cf_password" @bind:event="oninput" />
                </div>
                <div class="form-group">
                    <label class="lbl">@Loc["lbl.displayName"]</label>
                    <input class="input" placeholder="Иванов И.И." @bind="cf_displayName" @bind:event="oninput" />
                </div>
                <div class="form-group">
                    <label class="lbl">@Loc["lbl.role"]</label>
                    <select class="input" @bind="cf_roleId">
                        <option value="0">@Loc["users.chooseRole"]</option>
                        @foreach (var r in State.RolesCache.Where(r => r.Name != RoleNames.Admin))
                        {
                            <option value="@r.Id">@r.DisplayName</option>
                        }
                    </select>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(createErr))
            {
                <div class="err-banner" style="margin-bottom:14px">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    @createErr
                </div>
            }

            <div style="display:flex;gap:10px;justify-content:flex-end">
                <button style="background:none;border:1px solid var(--border);border-radius:12px;padding:10px 20px;color:var(--text-muted);cursor:pointer;font-size:13px;transition:all .2s"
                        @onclick="() => showCreate = false">
                    @Loc["btn.cancel"]
                </button>
                <button class="btn-primary" @onclick="CreateUser">@Loc["btn.create"]</button>
            </div>
        </div>
    </div>
}

@code {
    List<UserItem> users = new();
    bool loading = false, showCreate = false;
    string loadErr = "", createErr = "", flashMsg = "";
    int resetId = -1; string newPwd = "";
    string cf_username = "", cf_password = "", cf_displayName = "";
    int cf_roleId = 0;

    protected override async Task OnInitializedAsync()
    {
        Loc.OnChange += StateHasChanged;
        await LoadUsers();
    }

    async Task LoadUsers()
    {
        loading = true; loadErr = "";
        try { users = await Api.GetUsersAsync(); }
        catch (Exception e) { loadErr = e.Message; }
        finally { loading = false; }
    }

    void ToggleCreate()
    {
        cf_username = cf_password = cf_displayName = "";
        cf_roleId = 0;
        createErr = "";
        showCreate = true;
    }

    async Task CreateUser()
    {
        createErr = "";
        if (string.IsNullOrWhiteSpace(cf_username) || string.IsNullOrWhiteSpace(cf_password) ||
            cf_roleId == 0 || string.IsNullOrWhiteSpace(cf_displayName))
        { createErr = Loc["users.fillAll"]; return; }
        try
        {
            var ok = await Api.CreateUserAsync(cf_username, cf_password, cf_displayName, cf_roleId);
            if (!ok) { createErr = Loc["users.loginTaken"]; return; }
            showCreate = false;
            await LoadUsers();
            Flash(Loc["users.userCreated"]);
        }
        catch (Exception e) { createErr = e.Message; }
    }

    void StartReset(int id) { resetId = id; newPwd = ""; }
    void CancelReset() { resetId = -1; newPwd = ""; }

    async Task SavePwd(int id)
    {
        if (string.IsNullOrWhiteSpace(newPwd)) return;
        try
        {
            await Api.UpdatePasswordAsync(id, newPwd);
            resetId = -1; newPwd = "";
            await LoadUsers();
            Flash(Loc["users.passwordChanged"]);
        }
        catch (Exception e) { loadErr = e.Message; }
    }

    async Task ToggleBlock(UserItem u)
    {
        try
        {
            await Api.UpdateBlockedAsync(u.Id, !u.IsBlocked);
            await LoadUsers();
            Flash(Loc["users.statusChanged"]);
        }
        catch (Exception e) { loadErr = e.Message; }
    }

    async Task DeleteUser(UserItem u)
    {
        try { await Api.DeleteUserAsync(u.Id); await LoadUsers(); Flash(Loc["users.deleted"]); }
        catch (Exception e) { loadErr = e.Message; }
    }

    void Flash(string msg)
    {
        flashMsg = msg;
        _ = Task.Delay(3000).ContinueWith(_ => { flashMsg = ""; InvokeAsync(StateHasChanged); });
    }

    string IsoDate(string? iso) => iso?.Length >= 10 ? iso[..10] : "";

    public void Dispose()
    {
        Loc.OnChange -= StateHasChanged;
    }
}
