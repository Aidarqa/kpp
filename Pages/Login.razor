@using KppBlazor.Services
@page "/login"
@using KppBlazor.Models
@using Microsoft.AspNetCore.Components.Web
@using System.Text.Json
@inject ApiService Api
@inject AppState State
@inject LocalizationService Loc
@inject IJSRuntime JS
@inject NavigationManager Nav

<div class="login-wrap">
    <div class="login-box">

        <div class="login-logo">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
        </div>
        <span class="login-title">@Loc["app.title"]</span>
        <p class="login-sub">@Loc["app.subtitle"]</p>

        <div style="text-align:left;margin-bottom:16px">
            <label class="lbl">@Loc["lbl.login"]</label>
            <input class="field" placeholder="Введите логин" @bind="username" @bind:event="oninput"
                   style="margin-bottom:0" autocomplete="username" />
        </div>
        <div style="text-align:left;margin-bottom:24px">
            <label class="lbl">@Loc["lbl.password"]</label>
            <input class="field" type="password" placeholder="Введите пароль"
                   @bind="password" @bind:event="oninput" @onkeydown="OnKeyDown"
                   style="margin-bottom:0" autocomplete="current-password" />
        </div>

        @if (!string.IsNullOrEmpty(errorMsg))
        {
            <div class="err-banner" style="margin-bottom:16px;text-align:left">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                @errorMsg
            </div>
        }

        <button class="btn-primary login-submit" @onclick="DoLogin" disabled="@loading">
            @if (loading) {
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="spin"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
                <span>@Loc["login.loggingIn"]</span>
            }
            else {
                <span>@Loc["btn.login"]</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            }
        </button>

        <!-- Тестовые аккаунты -->
        <div style="margin-top:24px;border-top:1px solid var(--border);padding-top:18px;text-align:left">
            <div style="color:var(--text-dim);font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.8px;margin-bottom:12px">
                @Loc["login.testAccounts"]
            </div>
            @foreach (var (login, pwd, role, iconClass) in Accounts)
            {
                var l = login; var p = pwd;
                <button @onclick="() => { username = l; password = p; }"
                        class="acct-btn">
                    <span class="acct-btn-icon @iconClass">
                        @if (iconClass == "admin") {
                            <svg viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                        } else if (iconClass == "kpp") {
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                        } else {
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                        }
                    </span>
                    <div style="flex:1;min-width:0">
                        <div style="color:var(--text);font-size:12px;font-weight:600">@role</div>
                        <div style="color:var(--text-muted);font-size:11px;font-family:'JetBrains Mono',monospace">@login / @pwd</div>
                    </div>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--text-dim)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>
                </button>
            }
        </div>
    </div>
</div>

@code {
    static readonly (string login, string pwd, string role, string iconClass)[] Accounts =
    {
        ("admin",   "admin123", "Администратор", "admin"),
        ("kpp",     "kpp123",   "Сотрудник КПП", "kpp"),
        ("it_user", "it123",    "Пользователь",  "user")
    };

    string username = "", password = "", errorMsg = "";
    bool loading = false;

    async Task DoLogin()
    {
        errorMsg = "";
        if (string.IsNullOrWhiteSpace(username) || string.IsNullOrWhiteSpace(password))
        { errorMsg = Loc["login.enterCredentials"]; return; }
        loading = true;
        try
        {
            var auth = await Api.LoginAsync(username, password);
            if (auth != null)
            {
                try { await JS.InvokeVoidAsync("localStorage.setItem", "kpp-auth", JsonSerializer.Serialize(auth)); } catch { }
                Api.SetAuth(auth);
                State.SetAuth(auth);
                if (auth.RoleName == RoleNames.Admin)
                    State.RolesCache = await Api.GetRolesAsync();
                Nav.NavigateTo(auth.CanViewHistory ? "/dashboard" : "/register");
            }
            else { errorMsg = Loc["login.wrongCredentials"]; }
        }
        catch (Exception e)
        {
            errorMsg = e.Message.Contains("403") ? Loc["login.accountBlocked"] : Loc["login.wrongCredentials"];
        }
        finally { loading = false; }
    }

    async Task OnKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter") await DoLogin(); }
}
