@using KppBlazor.Services
@page "/history"
@using KppBlazor.Models
@inject ApiService Api
@inject AppState State
@inject ThemeService Theme
@inject LocalizationService Loc
@inject IJSRuntime JS
@inject NavigationManager Nav
@implements IDisposable

<div class="page-fill">
    <div class="page-header">
        <div style="display:flex;align-items:center;gap:14px">
            <div class="page-title-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                </svg>
            </div>
            <div>
                <div class="page-title">@Loc["history.title"]</div>
                <div class="page-subtitle">@Loc["history.subtitle"]</div>
            </div>
        </div>
        <div style="display:flex;gap:8px;align-items:center">
            <button class="btn-primary" @onclick="Refresh" disabled="@loading">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="@(loading ? "spin" : "")">
                    <polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/>
                    <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/>
                </svg>
                @Loc["btn.refresh"]
            </button>
        </div>
    </div>

    <!-- Фильтры -->
    <div class="filter-panel">
        <div class="filter-row">
            <input class="filter-search" placeholder="@Loc["lbl.search"]"
                   @bind="search" @bind:event="oninput" @bind:after="LoadData" />
            <div class="filter-btns">
                @foreach (var sf in StatusFilters)
                {
                    var sv = sf.Val;
                    <button class="btn-filter @(status == sv ? "active" : "")"
                            @onclick="() => { status = sv; _ = LoadData(); }">@sf.Lbl</button>
                }
            </div>
        </div>
        <div class="filter-row">
            <span style="color:var(--text-muted);font-size:12px">@Loc["history.from"]</span>
            <input type="date" class="date-inp" value="@dateFrom"
                   @onchange="e => { dateFrom = e.Value?.ToString() ?? string.Empty; _ = LoadData(); }" />
            <span style="color:var(--text-muted);font-size:12px">@Loc["history.to"]</span>
            <input type="date" class="date-inp" value="@dateTo"
                   @onchange="e => { dateTo = e.Value?.ToString() ?? string.Empty; _ = LoadData(); }" />
            <button class="btn-quick" @onclick="SetToday">@Loc["history.today"]</button>
            <button class="btn-quick" @onclick="SetWeek">@Loc["history.week"]</button>
            @if (!string.IsNullOrEmpty(dateFrom) || !string.IsNullOrEmpty(dateTo))
            {
                <button class="btn-quick" @onclick="ClearDates">@Loc["history.reset"]</button>
            }
            @if (response != null)
            {
                <span class="filter-count">@Loc["history.found"] @response.Summary.TotalCount</span>
            }
        </div>
    </div>

    <!-- Итоговая строка -->
    @if (response != null)
    {
        <div class="summary-bar">
            <div class="summary-item">
                <span class="summary-val">@response.Summary.TotalCount</span>
                <span class="summary-lbl">@Loc["dashboard.total"]</span>
            </div>
            <div class="summary-sep"></div>
            <div class="summary-item">
                <span class="summary-val" style="color:var(--good-text)">@response.Summary.OngoingCount</span>
                <span class="summary-lbl">@Loc["dashboard.inside"]</span>
            </div>
            <div class="summary-sep"></div>
            <div class="summary-item">
                <span class="summary-val" style="color:var(--bad-text)">@response.Summary.CompletedCount</span>
                <span class="summary-lbl">@Loc["history.exited"]</span>
            </div>
            <div class="summary-sep"></div>
            <div class="summary-item">
                <span class="summary-val" style="color:var(--text-muted)">@response.Summary.TotalDurationFormatted</span>
                <span class="summary-lbl">—</span>
            </div>
        </div>
    }

    <!-- Таблица -->
    <div class="table-wrap table-fill">
        @if (loading)
        {
            <div class="loading">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="spin"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
                @Loc["history.loading"]
            </div>
        }
        else if (!string.IsNullOrEmpty(loadErr))
        {
            <div class="err-banner" style="margin:20px">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                @loadErr
            </div>
        }
        else if (response == null || !response.Items.Any())
        {
            <div class="table-msg">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                </svg>
                <div>@Loc["history.noRecords"]</div>
            </div>
        }
        else
        {
            <table>
                <thead>
                    <tr>
                        <th>@Loc["history.guest"]</th>
                        <th>@Loc["history.purpose"]</th>
                        <th>@Loc["history.car"]</th>
                        <th>@Loc["history.entry"]</th>
                        <th>@Loc["history.exit"]</th>
                        <th>@Loc["history.time"]</th>
                        <th>@Loc["history.status"]</th>
                        <th>@Loc["history.docs"]</th>
                        @if (canManage)
                        {
                            <th style="text-align:center">@Loc["history.actions"]</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var g in response.Items)
                    {
                        var item = g;
                        <tr class="row" @onclick="() => detailGuest = item">
                            <td>
                                <div class="guest-name">@g.FullName</div>
                                @if (!string.IsNullOrEmpty(g.Passport))
                                {
                                    <div class="guest-pass">@g.Nationality &middot; @g.Passport</div>
                                }
                                @if (g.GroupId != null)
                                {
                                    <span class="tag tag-group">группа</span>
                                }
                            </td>
                            <td>
                                <div style="font-size:12px;color:var(--text-2)">@g.Purpose</div>
                                @if (!string.IsNullOrEmpty(g.Host))
                                {
                                    <div class="cell-sm">→ @g.Host</div>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(g.CarPlate))
                                {
                                    <span class="car-plate">@g.CarPlate</span>
                                    @if (!string.IsNullOrEmpty(g.CarBrand))
                                    {
                                        <div class="cell-sm">@g.CarBrand</div>
                                    }
                                }
                                else
                                {
                                    <span style="color:var(--text-dim)">—</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(g.EntryTime))
                                {
                                    <span class="time-entry">@FmtTime(g.EntryTime)</span>
                                }
                                else if (!string.IsNullOrEmpty(g.PlannedDate))
                                {
                                    <span class="time-plan">план: @FmtTime(g.PlannedDate)</span>
                                }
                                else
                                {
                                    <span style="color:var(--text-dim)">—</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(g.ExitTime))
                                {
                                    <span class="time-exit">@FmtTime(g.ExitTime)</span>
                                }
                                else
                                {
                                    <span style="color:var(--text-dim)">—</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(g.DurationFormatted))
                                {
                                    @if (g.Status == GuestStatus.Inside)
                                    {
                                        <span class="time-ongoing">@g.DurationFormatted</span>
                                    }
                                    else
                                    {
                                        <span class="time-duration">@g.DurationFormatted</span>
                                    }
                                }
                                else
                                {
                                    <span style="color:var(--text-dim)">—</span>
                                }
                            </td>
                            <td>
                                <span class="@BadgeCls(g.Status)">@BadgeTxt(g.Status)</span>
                            </td>
                            <td>
                                <div class="doc-col">
                                    @if (g.HasPassportScan)
                                    {
                                        <span class="doc-yes">
                                            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                                            Паспорт
                                        </span>
                                    }
                                    @if (g.HasPermitDoc)
                                    {
                                        <span class="doc-yes">
                                            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                                            Пропуск
                                        </span>
                                    }
                                    @if (!g.HasPassportScan && !g.HasPermitDoc)
                                    {
                                        <span class="doc-no">нет</span>
                                    }
                                </div>
                            </td>
                            @if (canManage)
                            {
                                <td style="text-align:center" @onclick:stopPropagation="true">
                                    @if (g.Status == GuestStatus.Pending)
                                    {
                                        <button class="btn-entry" @onclick="() => Entry(item)">
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                                            @Loc["action.entry"]
                                        </button>
                                    }
                                    else if (g.Status == GuestStatus.Inside)
                                    {
                                        <button class="btn-exit" @onclick="() => Exit(item)">
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><rect x="3" y="3" width="18" height="18" rx="2"/></svg>
                                            @Loc["action.exit"]
                                        </button>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<!-- Детальная карточка гостя -->
@if (detailGuest != null)
{
    <div class="modal-bg" @onclick="() => detailGuest = null">
        <div class="modal-box" @onclick:stopPropagation="true">
            <div class="modal-hdr">
                <span class="modal-hdr-title">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                        <circle cx="12" cy="7" r="4"/>
                    </svg>
                    @detailGuest.FullName
                </span>
                <button class="modal-close" @onclick="() => detailGuest = null">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>
            </div>
            <div class="modal-row">
                <span class="modal-lbl">@Loc["history.status"]</span>
                <span class="modal-val"><span class="@BadgeCls(detailGuest.Status)">@BadgeTxt(detailGuest.Status)</span></span>
            </div>
            @if (!string.IsNullOrEmpty(detailGuest.Passport))
            {
                <div class="modal-row">
                    <span class="modal-lbl">@Loc["register.passport"]</span>
                    <span class="modal-val">
                        @detailGuest.Nationality &middot; @detailGuest.Passport
                        @if (!string.IsNullOrEmpty(detailGuest.Dob)) { <span style="color:var(--text-muted)"> · @detailGuest.Dob</span> }
                    </span>
                </div>
            }
            <div class="modal-row">
                <span class="modal-lbl">@Loc["register.purpose"]</span>
                <span class="modal-val">@(detailGuest.Purpose ?? "—")</span>
            </div>
            <div class="modal-row">
                <span class="modal-lbl">@Loc["register.host"]</span>
                <span class="modal-val">@(detailGuest.Host ?? "—")</span>
            </div>
            @if (!string.IsNullOrEmpty(detailGuest.CarPlate))
            {
                <div class="modal-row">
                    <span class="modal-lbl">@Loc["register.transport"]</span>
                    <span class="modal-val"><span class="car-plate">@detailGuest.CarPlate</span> @detailGuest.CarBrand</span>
                </div>
            }
            @if (!string.IsNullOrEmpty(detailGuest.PlannedDate))
            {
                <div class="modal-row">
                    <span class="modal-lbl">@Loc["register.plannedDate"]</span>
                    <span class="modal-val">@FmtTime(detailGuest.PlannedDate)</span>
                </div>
            }
            @if (!string.IsNullOrEmpty(detailGuest.EntryTime))
            {
                <div class="modal-row">
                    <span class="modal-lbl">@Loc["history.entry"]</span>
                    <span class="modal-val"><span class="time-entry">@FmtTime(detailGuest.EntryTime)</span></span>
                </div>
            }
            @if (!string.IsNullOrEmpty(detailGuest.ExitTime))
            {
                <div class="modal-row">
                    <span class="modal-lbl">@Loc["history.exit"]</span>
                    <span class="modal-val"><span class="time-exit">@FmtTime(detailGuest.ExitTime)</span></span>
                </div>
            }
            @if (!string.IsNullOrEmpty(detailGuest.DurationFormatted))
            {
                <div class="modal-row">
                    <span class="modal-lbl">—</span>
                    <span class="modal-val">@detailGuest.DurationFormatted</span>
                </div>
            }
            <div class="modal-row">
                <span class="modal-lbl">—</span>
                <span class="modal-val">@(detailGuest.CreatedBy ?? "—")</span>
            </div>
            @if (detailGuest.HasPassportScan || detailGuest.HasPermitDoc)
            {
                <div class="modal-row">
                    <span class="modal-lbl">@Loc["history.docs"]</span>
                    <span class="modal-val">
                        <div style="display:flex;gap:8px;flex-wrap:wrap">
                            @if (detailGuest.HasPassportScan)
                            {
                                @if (detailGuest.PassportScanBase64 != null)
                                {
                                    <button class="btn-sm btn-sm-blue"
                                            @onclick='async () => await JS.InvokeVoidAsync("viewDoc", detailGuest.PassportScanBase64)'>
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                        @Loc["register.passportScan"]
                                    </button>
                                }
                                else { <span class="doc-yes"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg> Паспорт</span> }
                            }
                            @if (detailGuest.HasPermitDoc)
                            {
                                @if (detailGuest.PermitDocBase64 != null)
                                {
                                    <button class="btn-sm btn-sm-blue"
                                            @onclick='async () => await JS.InvokeVoidAsync("viewDoc", detailGuest.PermitDocBase64)'>
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                        @Loc["register.permitDoc"]
                                    </button>
                                }
                                else { <span class="doc-yes"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg> Пропуск</span> }
                            }
                        </div>
                    </span>
                </div>
            }
            @if (canManage && (detailGuest.Status == GuestStatus.Pending || detailGuest.Status == GuestStatus.Inside))
            {
                <div style="margin-top:18px;display:flex;gap:10px">
                    @{ var dg = detailGuest; }
                    @if (detailGuest.Status == GuestStatus.Pending)
                    {
                        <button class="btn-entry" style="padding:10px 24px;font-size:13px"
                                @onclick="async () => { detailGuest = null; await Entry(dg); }">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                            @Loc["action.entry"]
                        </button>
                    }
                    else
                    {
                        <button class="btn-exit" style="padding:10px 24px;font-size:13px"
                                @onclick="async () => { detailGuest = null; await Exit(dg); }">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><rect x="3" y="3" width="18" height="18" rx="2"/></svg>
                            @Loc["action.exit"]
                        </button>
                    }
                </div>
            }
        </div>
    </div>
}

@code {
    record StatusFilter(string Val, string Lbl);

    StatusFilter[] StatusFilters => new StatusFilter[]
    {
        new(GuestStatus.All,      Loc["history.all"]),
        new(GuestStatus.Pending,  Loc["history.pending"]),
        new(GuestStatus.Inside,   Loc["history.inside"]),
        new(GuestStatus.Exited,   Loc["history.exited"])
    };

    [SupplyParameterFromQuery]
    string search { get; set; } = "";
    
    string status = GuestStatus.All;
    string dateFrom = "", dateTo = "";
    bool loading;
    bool _isLoading;  // re-entrancy guard
    string loadErr = "";
    GuestListResponse? response;
    GuestItem? detailGuest;

    bool canManage => State.Auth?.CanManageEntry == true;

    private Timer? _autoRefreshTimer;

    protected override async Task OnInitializedAsync()
    {
        State.OnChange += OnStateChanged;
        Loc.OnChange += StateHasChanged;
        await LoadData();
        // Применяем фильтр, если передан через query-параметр или из AppState
        if (State.HistoryFilterPending)
        {
            State.HistoryFilterPending = false;
            ApplyFilter(State.HistoryFilter);
            _ = LoadData();
        }
        // Auto-refresh every 30 seconds
        _autoRefreshTimer = new Timer(async _ =>
        {
            try { await InvokeAsync(async () => { await LoadData(); }); }
            catch { }
        }, null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    void ApplyFilter(string filter)
    {
        if (filter == GuestStatus.All)
        {
            status = GuestStatus.All;
            dateFrom = dateTo = "";
        }
        else if (filter == "today")
        {
            dateFrom = dateTo = DateTime.Today.ToString("yyyy-MM-dd");
            status = GuestStatus.All;
        }
        else if (filter == "week")
        {
            dateFrom = DateTime.Today.AddDays(-6).ToString("yyyy-MM-dd");
            dateTo = DateTime.Today.ToString("yyyy-MM-dd");
            status = GuestStatus.All;
        }
        else
        {
            status = filter;
            dateFrom = dateTo = "";
        }
    }

    void OnStateChanged()
    {
        if (State.HistoryFilterPending)
        {
            State.HistoryFilterPending = false;
            ApplyFilter(State.HistoryFilter);
            _ = LoadData();
        }
        if (!_isLoading) StateHasChanged();
    }

    public void Dispose()
    {
        State.OnChange -= OnStateChanged;
        Loc.OnChange -= StateHasChanged;
        _autoRefreshTimer?.Dispose();
    }

    async Task LoadData()
    {
        if (_isLoading) return;  // prevent re-entrant calls
        _isLoading = true;
        loading = true; loadErr = "";
        StateHasChanged();
        try
        {
            response = await Api.GetGuestsAsync(search, status, dateFrom, dateTo);
        }
        catch (Exception e) { loadErr = e.Message; }
        finally
        {
            loading = false;
            _isLoading = false;
        }
        // Update sidebar stats AFTER loading is done (won't cause loop)
        await RefreshStats();
    }

    async Task Refresh() => await LoadData();

    async Task RefreshStats()
    {
        try
        {
            var all = await Api.GetGuestsAsync();
            var today = DateTime.Today.ToString("yyyy-MM-dd");
            var todayR = await Api.GetGuestsAsync("", GuestStatus.All, today, today);
            State.UpdateStats(new SidebarStats
            {
                InsideCnt  = all.Items.Count(g => g.Status == GuestStatus.Inside),
                TodayCnt   = todayR.Summary.TotalCount,
                PendingCnt = all.Items.Count(g => g.Status == GuestStatus.Pending),
                Total      = all.Summary.TotalCount
            });
        }
        catch { }
    }

    void SetToday()
    {
        dateFrom = dateTo = DateTime.Today.ToString("yyyy-MM-dd");
        _ = LoadData();
    }

    void SetWeek()
    {
        dateFrom = DateTime.Today.AddDays(-6).ToString("yyyy-MM-dd");
        dateTo   = DateTime.Today.ToString("yyyy-MM-dd");
        _ = LoadData();
    }

    void ClearDates() { dateFrom = dateTo = ""; _ = LoadData(); }

    async Task Entry(GuestItem g) { await Api.GuestEntryAsync(g.Id); await LoadData(); }
    async Task Exit(GuestItem  g) { await Api.GuestExitAsync(g.Id);  await LoadData(); }

    static string FmtTime(string? iso)
    {
        if (string.IsNullOrEmpty(iso)) return "—";
        if (DateTime.TryParse(iso, out var dt))
            return dt.Date == DateTime.Today ? dt.ToString("HH:mm") : dt.ToString("dd.MM HH:mm");
        return iso.Length >= 10 ? iso[..10] : iso;
    }

    static string BadgeCls(string s) => s switch
    {
        GuestStatus.Inside  => "badge-inside",
        GuestStatus.Exited  => "badge-exited",
        GuestStatus.Pending => "badge-pending",
        _                   => "badge-pending"
    };

    string BadgeTxt(string s) => s switch
    {
        GuestStatus.Inside  => Loc["history.inside"],
        GuestStatus.Exited  => Loc["history.exited"],
        GuestStatus.Pending => Loc["history.pending"],
        _                   => s
    };
}
