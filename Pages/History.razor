
@using KppBlazor.Services
@using KppBlazor.Models
@inject ApiService Api
@inject AppState State
@implements IDisposable

<div>
    <div class="page-title">📋 История посещений</div>

    <!-- Панель фильтров -->
    <div class="filter-panel">
        <div class="filter-row">
            <input class="filter-search" placeholder="🔍 Поиск по ФИО, паспорту, ТС, статусу..."
                   @bind="search" @bind:event="oninput" @oninput="OnSearchInput" />
            <div class="filter-btns">
                @foreach (var (val, label) in filterBtns)
                {
                    var v = val;
                    <button class="btn-filter @(fStatus == v ? "active" : "")"
                            @onclick="() => SetStatus(v)">@label</button>
                }
            </div>
        </div>
        <div class="filter-row">
            <span style="color:#7899bb;font-size:12px">📅</span>
            <input class="date-inp" type="date" @bind="dFrom" @bind:event="onchange" @onchange="Load" />
            <span style="color:#7899bb;font-size:12px">—</span>
            <input class="date-inp" type="date" @bind="dTo" @bind:event="onchange" @onchange="Load" />
            <button class="btn-quick" @onclick="SetToday">Сегодня</button>
            <button class="btn-quick" @onclick="SetWeek">7 дней</button>
            <button class="btn-quick" @onclick="ClearDates">Все</button>
            <span class="filter-count">@countText</span>
        </div>
    </div>

    <!-- Сводная панель -->
    @if (summary != null)
    {
        <div class="summary-bar">
            <div class="summary-item">
                <div class="summary-val">@summary.TotalCount</div>
                <div class="summary-lbl">Записей</div>
            </div>
            <div class="summary-sep"></div>
            <div class="summary-item">
                <div class="summary-val">@summary.TotalDurationFormatted</div>
                <div class="summary-lbl">Суммарное время</div>
            </div>
            <div class="summary-sep"></div>
            <div class="summary-item">
                <div class="summary-val">@summary.CompletedCount</div>
                <div class="summary-lbl">Завершено</div>
            </div>
            <div class="summary-sep"></div>
            <div class="summary-item">
                <div class="summary-val">@summary.OngoingCount</div>
                <div class="summary-lbl">Внутри сейчас</div>
            </div>
        </div>
    }

    <!-- Таблица -->
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>№</th>
                    <th>ФИО / Паспорт</th>
                    <th>Цель / Принимающий</th>
                    <th>🚗 ТС</th>
                    <th>Вход</th>
                    <th>Выход</th>
                    <th>⏱ Длительность</th>
                    <th>Статус</th>
                    <th>Документы</th>
                    @if (canManage) { <th>Действие</th> }
                </tr>
            </thead>
            <tbody>
                @if (loading)
                {
                    <tr><td colspan="@colSpan" class="table-msg">⏳ Загрузка...</td></tr>
                }
                else if (!string.IsNullOrEmpty(errorMsg))
                {
                    <tr><td colspan="@colSpan" class="table-err">⚠️ @errorMsg</td></tr>
                }
                else if (items.Count == 0)
                {
                    <tr><td colspan="@colSpan" class="table-msg">Записей не найдено</td></tr>
                }
                else
                {
                    @for (int i = 0; i < items.Count; i++)
                    {
                        var g = items[i];
                        var idx = i + 1;
                        <tr class="row" @onclick="() => OpenModal(g)">
                            <td><span style="color:#445566;font-size:11px">@idx</span></td>
                            <td>
                                <div class="guest-name">@g.FullName</div>
                                <div class="guest-pass">@(g.Passport ?? "—")</div>
                                @if (!string.IsNullOrEmpty(g.GroupId)) { <span class="tag tag-group">Группа</span> }
                                @if (g.Status == "pending") { <span class="tag tag-pending">Заявка</span> }
                            </td>
                            <td>
                                <div style="font-size:12px">@(g.Purpose ?? "—")</div>
                                <div class="cell-sm">@(g.Host ?? "")</div>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(g.CarBrand) || !string.IsNullOrEmpty(g.CarPlate))
                                {
                                    <div style="font-size:12px">@(g.CarBrand ?? "")</div>
                                    <div class="car-plate">@(g.CarPlate ?? "")</div>
                                }
                                else { <span style="color:#444">—</span> }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(g.EntryTime))
                                { <span class="time-entry">@FmtDT(g.EntryTime)</span> }
                                else if (!string.IsNullOrEmpty(g.PlannedDate))
                                { <span class="time-plan">📅 @FmtDT(g.PlannedDate)?.Substring(0,10)</span> }
                                else { <span style="color:#444">—</span> }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(g.ExitTime))
                                { <span class="time-exit">@FmtDT(g.ExitTime)</span> }
                                else { <span style="color:#444">—</span> }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(g.DurationFormatted))
                                {
                                    @if (g.Status == "inside")
                                    { <span class="time-ongoing">🟢 @g.DurationFormatted</span> }
                                    else
                                    { <span class="time-duration">⏱ @g.DurationFormatted</span> }
                                }
                                else { <span style="color:#444">—</span> }
                            </td>
                            <td>@((MarkupString)BadgeHtml(g.Status))</td>
                            <td>
                                <div class="doc-col">
                                    <span class="@(g.HasPassportScan ? "doc-yes" : "doc-no")">
                                        📄 @(g.HasPassportScan ? "Паспорт" : "нет")
                                    </span>
                                    <span class="@(g.HasPermitDoc ? "doc-yes" : "doc-no")">
                                        📑 @(g.HasPermitDoc ? "Пропуск" : "нет")
                                    </span>
                                </div>
                            </td>
                            @if (canManage)
                            {
                                <td @onclick:stopPropagation="true">
                                    @if (g.Status == "pending")
                                    {
                                        <button class="btn-entry" @onclick="() => DoEntry(g)">⬇ Вход</button>
                                    }
                                    @if (g.Status == "inside")
                                    {
                                        <button class="btn-exit" @onclick="() => DoExit(g)">⬆ Выход</button>
                                    }
                                </td>
                            }
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Модальное окно гостя -->
@if (selectedGuest != null)
{
    <div class="modal-bg" @onclick="CloseModal">
        <div class="modal-box" @onclick:stopPropagation="true">
            <div class="modal-hdr">
                <h3 style="color:#e0eaf5;margin:0;font-size:18px">🪪 Карточка гостя</h3>
                <button class="modal-close" @onclick="CloseModal">✕</button>
            </div>
            @foreach (var (label, value, isPlate) in ModalRows(selectedGuest))
            {
                <div class="modal-row">
                    <span class="modal-lbl">@label</span>
                    <span class="modal-val"
                          style="color:@(isPlate ? "#ffcc02" : "#e0eaf5");font-family:@(isPlate ? "monospace" : "inherit")">
                        @value
                    </span>
                </div>
            }
            <div class="modal-row" style="align-items:center">
                <span class="modal-lbl">Статус</span>
                @((MarkupString)BadgeHtml(selectedGuest.Status))
            </div>
        </div>
    </div>
}

@code {
    string search = "", fStatus = "all", dFrom = "", dTo = "";
    string countText = "", errorMsg = "";
    bool loading = false;
    List<GuestItem> items = new();
    GuestSummary? summary;
    GuestItem? selectedGuest;
    System.Timers.Timer? refreshTimer;

    bool canManage => State.Auth?.CanManageEntry == true;
    int colSpan => canManage ? 10 : 9;

    static readonly (string val, string label)[] filterBtns =
    {
        ("all","Все"),("pending","🟡 Ожидается"),("inside","🟢 Внутри"),("exited","🔴 Вышли")
    };

    System.Timers.Timer? searchTimer;

    void OnSearchInput(ChangeEventArgs e)
    {
        search = e.Value?.ToString() ?? "";
        searchTimer?.Stop();
        searchTimer?.Dispose();
        searchTimer = new System.Timers.Timer(400);
        searchTimer.Elapsed += async (_, _) => { searchTimer?.Dispose(); await InvokeAsync(Load); };
        searchTimer.AutoReset = false;
        searchTimer.Start();
    }

    void SetStatus(string v) { fStatus = v; _ = Load(); }
    void SetToday() { dFrom = dTo = DateTime.Today.ToString("yyyy-MM-dd"); _ = Load(); }
    void SetWeek()  { dFrom = DateTime.Today.AddDays(-7).ToString("yyyy-MM-dd"); dTo = DateTime.Today.ToString("yyyy-MM-dd"); _ = Load(); }
    void ClearDates() { dFrom = dTo = ""; _ = Load(); }

    protected override async Task OnInitializedAsync()
    {
        await Load();
        refreshTimer = new System.Timers.Timer(30000);
        refreshTimer.Elapsed += async (_, _) => await InvokeAsync(async () => { await Load(); StateHasChanged(); });
        refreshTimer.AutoReset = true;
        refreshTimer.Start();
    }

    async Task Load()
    {
        loading = true; errorMsg = ""; StateHasChanged();
        try
        {
            var data = await Api.GetGuestsAsync(search, fStatus, dFrom, dTo);
            items = data.Items;
            summary = data.Summary;
            countText = $"Найдено: {data.Summary.TotalCount}";
            State.UpdateStats(new SidebarStats
            {
                InsideCnt  = items.Count(g => g.Status == "inside"),
                TodayCnt   = items.Count(g => IsoDate(g.EntryTime) == DateTime.Today.ToString("yyyy-MM-dd")),
                PendingCnt = items.Count(g => g.Status == "pending"),
                Total      = items.Count
            });
        }
        catch (Exception e) { errorMsg = e.Message; }
        finally { loading = false; StateHasChanged(); }
    }

    async Task DoEntry(GuestItem g)
    {
        try { await Api.GuestEntryAsync(g.Id); await Load(); }
        catch (Exception e) { errorMsg = e.Message; }
    }

    async Task DoExit(GuestItem g)
    {
        try { await Api.GuestExitAsync(g.Id); await Load(); }
        catch (Exception e) { errorMsg = e.Message; }
    }

    void OpenModal(GuestItem g) => selectedGuest = g;
    void CloseModal() => selectedGuest = null;

    string? FmtDT(string? iso) =>
        string.IsNullOrEmpty(iso) ? null :
        DateTime.TryParse(iso, out var dt) ? dt.ToString("dd.MM.yyyy HH:mm") : iso;

    string IsoDate(string? iso) => iso?.Length >= 10 ? iso[..10] : "";

    string BadgeHtml(string status) => status switch
    {
        "inside"  => "<span class=\"badge-inside\">🟢 Внутри</span>",
        "exited"  => "<span class=\"badge-exited\">🔴 Вышел</span>",
        _         => "<span class=\"badge-pending\">🟡 Ожидается</span>"
    };

    IEnumerable<(string label, string value, bool isPlate)> ModalRows(GuestItem g)
    {
        yield return ("ФИО",           g.FullName,                           false);
        yield return ("Дата рождения", g.Dob          ?? "—",                false);
        yield return ("Серия/Номер",   g.Passport     ?? "—",                false);
        yield return ("Гражданство",   g.Nationality  ?? "—",                false);
        yield return ("Цель визита",   g.Purpose      ?? "—",                false);
        yield return ("Принимающий",   g.Host         ?? "—",                false);
        yield return ("🚗 Марка ТС",   g.CarBrand     ?? "—",                false);
        yield return ("🔢 Номер ТС",   g.CarPlate     ?? "—",                true);
        yield return ("Плановая дата", g.PlannedDate != null ? (FmtDT(g.PlannedDate) ?? "—") : "—", false);
        yield return ("Вход",          FmtDT(g.EntryTime) ?? "—",            false);
        yield return ("Выход",         FmtDT(g.ExitTime)  ?? "—",            false);
        yield return ("⏱ Длительность",g.DurationFormatted ?? "—",           false);
        yield return ("Создал",        g.CreatedBy ?? "—",                   false);
    }

    public void Dispose()
    {
        refreshTimer?.Dispose();
        searchTimer?.Dispose();
    }
}
