
@using KppBlazor.Services
@using KppBlazor.Models
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@inject ApiService Api
@inject AppState State
@inject IJSRuntime JS

<div>
    <div class="page-title">
        @(isAdmin ? "📝 Предварительная заявка" : isKpp ? "🛂 Регистрация гостя" : "✍️ Создать заявку")
    </div>

    <div class="@bannerCls">@bannerTxt</div>

    <div class="card" style="max-width:780px">
        <!-- Основные поля -->
        <div class="form-grid">
            <div class="form-group">
                <label class="lbl">Цель визита</label>
                <input class="input" placeholder="Напр.: Встреча с руководством"
                       @bind="purpose" @bind:event="oninput" />
            </div>
            <div class="form-group">
                <label class="lbl">Принимающее лицо</label>
                <input class="input" placeholder="ФИО и должность"
                       @bind="host" @bind:event="oninput" />
            </div>
            @if (!isKpp)
            {
                <div class="form-group">
                    <label class="lbl">📅 Планируемая дата</label>
                    <input class="input" type="date" @bind="plannedDate" />
                </div>
            }
        </div>

        <!-- ТС -->
        <div class="section-div">🚗 Транспортное средство <span style="color:#7899bb;font-weight:400">(необязательно)</span></div>
        <div class="form-grid" style="margin-bottom:20px">
            <div class="form-group">
                <label class="lbl">Марка</label>
                <input class="input" placeholder="Toyota, BMW…" @bind="carBrand" @bind:event="oninput" />
            </div>
            <div class="form-group">
                <label class="lbl">Гос. номер</label>
                <input class="input" placeholder="01KG777SSS" @bind="carPlate" @bind:event="oninput"
                       @oninput="e => OnCarPlateInput(e.Value?.ToString())" />
            </div>
        </div>

        <!-- Режим -->
        <div class="mode-toggle">
            <button class="btn-mode @(!groupMode ? "active" : "")" @onclick="() => SwitchMode(false)">👤 Один гость</button>
            <button class="btn-mode @(groupMode ? "active" : "")" @onclick="() => SwitchMode(true)">👥 Группа</button>
        </div>

        <!-- Одиночный гость -->
        @if (!groupMode)
        {
            <!-- Скан паспорта -->
            <div class="scan-zone">
                <div class="scan-icon">📄</div>
                <div class="scan-title">Сканировать паспорт</div>
                <div class="scan-sub">ИИ автоматически распознает данные</div>
                <label class="btn-scan">
                    📷 Загрузить скан паспорта
                    <InputFile OnChange="OnPassportScan" accept="image/*,application/pdf" style="display:none" />
                </label>
                @if (!string.IsNullOrEmpty(scanMsg))
                {
                    <div class="scan-msg" style="color:@scanMsgColor">@scanMsg</div>
                }
            </div>

            <div class="form-grid" style="margin-bottom:16px">
                <div class="form-group">
                    <label class="lbl">ФИО <span style="color:#7ecfff;font-size:10px;text-transform:none;font-weight:400">(авто)</span></label>
                    <input class="input" placeholder="Фамилия Имя Отчество" @bind="fullName" @bind:event="oninput" />
                </div>
                <div class="form-group">
                    <label class="lbl">Дата рождения <span style="color:#7ecfff;font-size:10px;text-transform:none;font-weight:400">(авто)</span></label>
                    <input class="input" placeholder="ДД.ММ.ГГГГ" maxlength="10" @bind="dob" @bind:event="oninput"
                           @oninput="e => dob = FormatDob(e.Value?.ToString() ?? string.Empty)" />
                </div>
                <div class="form-group">
                    <label class="lbl">Серия и номер <span style="color:#7ecfff;font-size:10px;text-transform:none;font-weight:400">(авто)</span></label>
                    <input class="input" placeholder="0000 000000" @bind="passport" @bind:event="oninput" />
                </div>
                <div class="form-group">
                    <label class="lbl">Гражданство <span style="color:#7ecfff;font-size:10px;text-transform:none;font-weight:400">(авто)</span></label>
                    <input class="input" placeholder="РФ" @bind="nationality" @bind:event="oninput" />
                </div>
            </div>

            <div class="form-group">
                <label class="lbl">📑 Пропускной документ</label>
                <InputFile OnChange="OnPermitDoc" accept="image/*,application/pdf" style="color:#7ecfff;font-size:13px" />
                @if (permitDocLoaded)
                {
                    <span style="color:#81c784;font-size:12px">✅ Загружен</span>
                }
            </div>
        }

        <!-- Групповая форма -->
        @if (groupMode)
        {
            @for (int i = 0; i < members.Count; i++)
            {
                var idx = i;
                var m = members[idx];
                <div class="member-card">
                    <div class="member-hdr">
                        <span class="member-title">Гость #@(idx + 1)</span>
                        @if (idx > 0)
                        {
                            <button class="btn-remove" @onclick="() => RemoveMember(idx)">✕ Удалить</button>
                        }
                    </div>
                    <div class="form-grid" style="margin-bottom:10px">
                        <div class="form-group">
                            <label class="lbl">ФИО</label>
                            <input class="input" placeholder="Фамилия Имя Отчество" value="@m.FullName"
                                   @oninput="e => m.FullName = e.Value?.ToString() ?? string.Empty" />
                        </div>
                        <div class="form-group">
                            <label class="lbl">Дата рождения</label>
                            <input class="input" placeholder="ДД.ММ.ГГГГ" maxlength="10" value="@m.Dob"
                                   @oninput="e => m.Dob = FormatDob(e.Value?.ToString() ?? string.Empty)" />
                        </div>
                        <div class="form-group">
                            <label class="lbl">Серия и номер</label>
                            <input class="input" placeholder="0000 000000" value="@m.Passport"
                                   @oninput="e => m.Passport = e.Value?.ToString() ?? string.Empty" />
                        </div>
                        <div class="form-group">
                            <label class="lbl">Гражданство</label>
                            <input class="input" placeholder="КР" value="@m.Nationality"
                                   @oninput="e => SetMemberNationality(m, e.Value?.ToString())" />
                        </div>
                    </div>
                </div>
            }
            <button class="btn-add-member" @onclick="AddMember">+ Добавить гостя</button>
        }

        @if (!string.IsNullOrEmpty(errMsg))
        {
            <div class="field-err">@errMsg</div>
        }

        <button class="btn-primary" style="width:100%;padding:14px;font-size:15px;margin-top:20px"
                @onclick="Submit" disabled="@submitting">
            @(submitting ? "⏳ Сохранение..." : submitLabel)
        </button>
    </div>
</div>

<!-- Модалка успеха -->
@if (showSuccess)
{
    <div class="modal-bg" @onclick="() => { showSuccess = false; State.Navigate(\" history\"); }">
        <div class="success-modal" @onclick:stopPropagation="true">
            <div class="success-icon">✅</div>
            <div class="success-title">@(isKpp ? "Гость зарегистрирован!" : "Заявка создана!")</div>
            <div class="success-sub">
                @(successCount > 1
                    ? $"{successCount} гостей успешно {(isKpp ? "зарегистрированы" : "добавлены")}"
                    : $"Гость успешно {(isKpp ? "зарегистрирован" : "добавлен в список ожидания")}")
            </div>
            <button class="btn-primary" style="padding:10px 32px"
                    @onclick="() => { showSuccess = false; State.Navigate(\" history\"); }">
                📋 В историю
            </button>
        </div>
    </div>
}

@code {
    bool isAdmin => State.Auth?.RoleName == "admin";
    bool isKpp => State.Auth?.CanManageEntry == true && !isAdmin;

    string purpose = "", host = "", carBrand = "", carPlate = "",
           fullName = "", dob = "", passport = "", nationality = "РФ";
    string plannedDate = DateTime.Today.ToString("yyyy-MM-dd");
    string? passportScanBase64, permitDocBase64;
    bool permitDocLoaded = false;
    bool groupMode = false, submitting = false, showSuccess = false;
    int successCount = 1;
    string errMsg = "", scanMsg = "", scanMsgColor = "#7ecfff";
    List<MemberForm> members = new() { new MemberForm() };

    string bannerCls => isAdmin ? "info-banner banner-admin" : isKpp ? "info-banner banner-kpp" : "info-banner banner-user";
    string bannerTxt => isAdmin ? "ℹ️ Заявка создаётся со статусом «Ожидается»."
                     : isKpp ? "ℹ️ Гость будет зарегистрирован со статусом «Внутри»."
                     : "ℹ️ Ваша заявка будет передана на КПП.";
    string submitLabel => isAdmin ? "📝 Создать заявку" : isKpp ? "🛂 Зарегистрировать" : "✍️ Отправить заявку";

    void SwitchMode(bool grp) { groupMode = grp; }
    void AddMember() => members.Add(new MemberForm());
    void RemoveMember(int i) => members.RemoveAt(i);

    void OnCarPlateInput(string? val) =>
        carPlate = (val ?? string.Empty).ToUpperInvariant();

    void SetMemberNationality(MemberForm m, string? val) =>
        m.Nationality = string.IsNullOrEmpty(val) ? "КР" : val;

    async Task OnPassportScan(InputFileChangeEventArgs e)
    {
        scanMsg = "🤖 ИИ распознаёт..."; scanMsgColor = "#7ecfff";
        var f = e.File;
        using var ms = new MemoryStream();
        await f.OpenReadStream(10_000_000).CopyToAsync(ms);
        var b64 = "data:" + f.ContentType + ";base64," + Convert.ToBase64String(ms.ToArray());
        passportScanBase64 = b64;
        scanMsg = "⚠️ Заполните вручную"; scanMsgColor = "#ffb74d";
        await Task.Delay(5000);
        scanMsg = "";
    }

    async Task OnPermitDoc(InputFileChangeEventArgs e)
    {
        var f = e.File;
        using var ms = new MemoryStream();
        await f.OpenReadStream(10_000_000).CopyToAsync(ms);
        permitDocBase64 = "data:" + f.ContentType + ";base64," + Convert.ToBase64String(ms.ToArray());
        permitDocLoaded = true;
    }

    string FormatDob(string raw)
    {
        var d = new string(raw.Where(char.IsDigit).ToArray());
        var r = "";
        for (int i = 0; i < d.Length && i < 8; i++)
        {
            if (i == 2 || i == 4) r += ".";
            r += d[i];
        }
        return r;
    }

    async Task Submit()
    {
        errMsg = "";
        if (string.IsNullOrWhiteSpace(purpose)) { errMsg = "Укажите цель визита"; return; }
        if (string.IsNullOrWhiteSpace(host)) { errMsg = "Укажите принимающее лицо"; return; }
        if (groupMode && members.Any(m => string.IsNullOrWhiteSpace(m.FullName)))
        { errMsg = "Введите ФИО для всех гостей"; return; }
        if (!groupMode && string.IsNullOrWhiteSpace(fullName))
        { errMsg = "Введите ФИО"; return; }

        submitting = true;
        var groupId = groupMode ? "G" + DateTimeOffset.UtcNow.ToUnixTimeMilliseconds() : null;
        try
        {
            if (groupMode)
            {
                foreach (var m in members)
                {
                    await Api.CreateGuestAsync(new GuestCreateRequest
                    {
                        FullName = m.FullName,
                        Dob = m.Dob.NullIfEmpty(),
                        Passport = m.Passport.NullIfEmpty(),
                        Nationality = m.Nationality.NullIfEmpty() ?? "КР",
                        Purpose = purpose,
                        Host = host,
                        CarBrand = carBrand.NullIfEmpty(),
                        CarPlate = carPlate.NullIfEmpty(),
                        PlannedDate = isKpp ? null : plannedDate,
                        GroupId = groupId
                    });
                }
                successCount = members.Count;
            }
            else
            {
                await Api.CreateGuestAsync(new GuestCreateRequest
                {
                    FullName = fullName,
                    Dob = dob.NullIfEmpty(),
                    Passport = passport.NullIfEmpty(),
                    Nationality = nationality.NullIfEmpty() ?? "КР",
                    Purpose = purpose,
                    Host = host,
                    CarBrand = carBrand.NullIfEmpty(),
                    CarPlate = carPlate.NullIfEmpty(),
                    PassportScanBase64 = passportScanBase64,
                    PermitDocBase64 = permitDocBase64,
                    PlannedDate = isKpp ? null : plannedDate
                });
                successCount = 1;
            }
            showSuccess = true;
        }
        catch (Exception e) { errMsg = e.Message; }
        finally { submitting = false; }
    }
}
