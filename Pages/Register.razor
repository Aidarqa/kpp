
@using KppBlazor.Services
@using KppBlazor.Models
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@inject ApiService Api
@inject AppState State
@inject LocalizationService Loc
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="page-fill page-fill-center">

    <!-- OCR Scan Indicator -->
    @if (ocrStatus == "scanning")
    {
        <div class="ocr-scanner">
            <div class="ocr-scanner-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
                    <circle cx="12" cy="13" r="4"/>
                </svg>
            </div>
            <div class="ocr-scanner-body">
                <div class="ocr-scanner-title">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="spin"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
                    @Loc["register.ocrScanning"]
                </div>
                <div class="ocr-progress-bar">
                    <div class="ocr-progress-fill" id="ocr-progress"></div>
                </div>
            </div>
        </div>
    }
    @if (ocrStatus == "done" && ocrFieldsFilled > 0)
    {
        <div class="ocr-result-card">
            <div class="ocr-result-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"/>
                </svg>
            </div>
            <div>
                <div class="ocr-result-text">@Loc["register.ocrDone"] @ocrFieldsFilled @Loc["register.ocrFieldsOf4"] @if(ocrMethod == "ai-vision") {<span class='ocr-method-badge'>AI</span>} else if(ocrMethod == "tesseract-v2") {<span class='ocr-method-badge'>OCR</span>}</div>
                <div class="ocr-result-details">@Loc["register.ocrVerify"]</div>
            </div>
        </div>
    }
    @if (ocrStatus == "error")
    {
        <div class="ocr-error-card">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            @Loc["register.ocrError"]
        </div>
    }

    <!-- Заголовок -->
    <div class="page-header" style="margin-bottom:10px">
        <div style="display:flex;align-items:center;gap:14px">
            <div class="page-title-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                </svg>
            </div>
            <div class="page-title">@(isAdmin ? Loc["register.title.admin"] : isKpp ? Loc["register.title.kpp"] : Loc["register.title.user"])</div>
        </div>
    </div>

    <!-- Информационная полоска -->
    <div class="@bannerCls" style="margin-bottom:12px;padding:10px 16px;font-size:12px">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
        @bannerTxt
    </div>

    <!-- Карточка формы -->
    <div class="card" style="padding:20px">

        <!-- Блок 1: Основная информация -->
        <div class="form-grid form-grid-3" style="margin-bottom:0">
            <div class="form-group">
                <label class="lbl">@Loc["register.purpose"]</label>
                <input class="input @(purposeError ? "input-error" : "")" placeholder="Напр.: Встреча с руководством"
                       @bind="purpose" @bind:event="oninput" />
            </div>
            <div class="form-group">
                <label class="lbl">@Loc["register.host"]</label>
                <input class="input @(hostError ? "input-error" : "")" placeholder="ФИО и должность"
                       @bind="host" @bind:event="oninput" />
            </div>
            <div class="form-group">
                <label class="lbl">@Loc["register.plannedDate"]</label>
                <input class="input" type="date" @bind="plannedDate" />
            </div>
        </div>

        <!-- Блок 2: Транспорт -->
        <div class="section-div">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            @Loc["register.transport"] <span>(@Loc["register.optional"])</span>
        </div>
        <div class="form-grid" style="margin-bottom:0">
            <div class="form-group">
                <label class="lbl">@Loc["register.carBrand"]</label>
                <input class="input" placeholder="Toyota, BMW..."
                       @bind="carBrand" @bind:event="oninput" />
            </div>
            <div class="form-group">
                <label class="lbl">@Loc["register.carPlate"]</label>
                <input class="input" placeholder="01KG777SSS" value="@carPlate"
                       @oninput="e => OnCarPlateInput(e.Value?.ToString())" />
            </div>
        </div>

        <!-- Блок 3: Гость -->
        <div class="section-div" style="margin-bottom:8px">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            @Loc["register.guestData"]
        </div>

        <!-- Переключатель: Один / Группа -->
        <div class="mode-toggle" style="margin-bottom:10px">
            <button class="btn-mode @(!groupMode ? "active" : "")" @onclick="() => SwitchMode(false)">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                @Loc["register.oneGuest"]
            </button>
            <button class="btn-mode @(groupMode ? "active" : "")" @onclick="() => SwitchMode(true)">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                @Loc["register.group"]
            </button>
        </div>

        <!-- Одиночный гость -->
        @if (!groupMode)
        {
            <div class="form-grid" style="margin-bottom:10px">
                <div class="form-group">
                    <label class="lbl">@Loc["register.fullName"] <span class="lbl-auto">авто</span></label>
                    <input class="input @(nameError ? "input-error" : "")" placeholder="Фамилия Имя Отчество"
                           @bind="fullName" @bind:event="oninput" />
                </div>
                <div class="form-group">
                    <label class="lbl">@Loc["register.dob"] <span class="lbl-auto">авто</span></label>
                    <input class="input" placeholder="ДД.ММ.ГГГГ" maxlength="10" value="@dob"
                           @oninput="e => dob = FormatDob(e.Value?.ToString() ?? string.Empty)" />
                </div>
                <div class="form-group">
                    <label class="lbl">@Loc["register.passport"] <span class="lbl-auto">авто</span></label>
                    <input class="input" placeholder="0000 000000"
                           @bind="passport" @bind:event="oninput" />
                </div>
                <div class="form-group">
                    <label class="lbl">@Loc["register.nationality"] <span class="lbl-auto">авто</span></label>
                    <input class="input" placeholder="РФ"
                           @bind="nationality" @bind:event="oninput" />
                </div>
            </div>

            <!-- Загрузка документов -->
            <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;
                        padding:12px 16px;background:var(--surface-2);
                        border:1px solid var(--border);border-radius:12px;margin-bottom:12px">
                <label class="btn-upload">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
                    @Loc["register.passportScan"]
                    <span class="lbl-auto" style="margin-left:2px">OCR</span>
                    <InputFile OnChange="OnPassportScan" accept="image/*,application/pdf" style="display:none" />
                </label>
                @if (!string.IsNullOrEmpty(scanMsg))
                {
                    <span style="font-size:11px;color:@scanMsgColor">@scanMsg</span>
                }
                <div style="width:1px;height:20px;background:var(--border);flex-shrink:0"></div>
                <label class="btn-upload">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
                    @Loc["register.permitDoc"]
                    <InputFile OnChange="OnPermitDoc" accept="image/*,application/pdf" style="display:none" />
                </label>
                @if (permitDocLoaded)
                {
                    <span style="color:var(--good-text);font-size:11px;font-weight:600;display:flex;align-items:center;gap:4px">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                        @Loc["register.loaded"]
                    </span>
                }
            </div>
        }

        <!-- Групповая форма -->
        @if (groupMode)
        {
            <div style="max-height:260px;overflow-y:auto;margin-bottom:8px">
                @for (int i = 0; i < members.Count; i++)
                {
                    var idx = i;
                    var m = members[idx];
                    <div class="member-card" style="padding:12px;margin-bottom:8px">
                        <div class="member-hdr" style="margin-bottom:8px">
                            <span class="member-title">@Loc["register.guest"] #@(idx + 1)</span>
                            @if (idx > 0)
                            {
                                <button class="btn-remove" @onclick="() => RemoveMember(idx)">@Loc["btn.delete"]</button>
                            }
                        </div>
                        <div class="form-grid" style="margin-bottom:0;gap:8px">
                            <div class="form-group">
                                <label class="lbl">@Loc["register.fullName"]</label>
                                <input class="input" placeholder="Фамилия Имя Отчество" value="@m.FullName"
                                       @oninput="e => m.FullName = e.Value?.ToString() ?? string.Empty" />
                            </div>
                            <div class="form-group">
                                <label class="lbl">@Loc["register.dob"]</label>
                                <input class="input" placeholder="ДД.ММ.ГГГГ" maxlength="10" value="@m.Dob"
                                       @oninput="e => m.Dob = FormatDob(e.Value?.ToString() ?? string.Empty)" />
                            </div>
                            <div class="form-group">
                                <label class="lbl">@Loc["register.passport"]</label>
                                <input class="input" placeholder="0000 000000" value="@m.Passport"
                                       @oninput="e => m.Passport = e.Value?.ToString() ?? string.Empty" />
                            </div>
                            <div class="form-group">
                                <label class="lbl">@Loc["register.nationality"]</label>
                                <input class="input" placeholder="КР" value="@m.Nationality"
                                       @oninput="e => SetMemberNationality(m, e.Value?.ToString())" />
                            </div>
                        </div>
                    </div>
                }
            </div>
            <button class="btn-add-member" @onclick="AddMember">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                @Loc["register.addGuest"]
            </button>
        }

        @if (!string.IsNullOrEmpty(errMsg))
        {
            <div class="field-err" style="margin-bottom:8px">@errMsg</div>
        }

        <button class="btn-primary" style="width:100%;padding:13px;font-size:14px;margin-top:4px"
                @onclick="Submit" disabled="@submitting">
            @if (submitting) {
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="spin"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
                <span>@Loc["register.saving"]</span>
            }
            else { <span>@submitLabel</span> }
        </button>
    </div>

</div>

<!-- Модалка успеха -->
@if (showSuccess)
{
    <div class="modal-bg" @onclick='() => showSuccess = false'>
        <div class="success-modal" @onclick:stopPropagation="true">
            <div class="success-icon-wrap">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"/>
                </svg>
            </div>
            <div class="success-title">@(isKpp ? Loc["register.registered"] : Loc["register.created"])</div>
            <div class="success-sub">
                @(successCount > 1
                    ? $"{successCount} {Loc["register.guestsRegistered"]}"
                    : Loc[isKpp ? "register.guestRegistered" : "register.guestAdded"])
            </div>
            @if (State.Auth?.CanViewHistory == true)
            {
                <button class="btn-primary" style="padding:11px 32px" @onclick="CloseSuccess">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    @Loc["register.toHistory"]
                </button>
            }
            else
            {
                <button class="btn-primary" style="padding:11px 32px"
                        @onclick='() => { showSuccess = false; ResetForm(); }'>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                    @Loc["register.newRequest"]
                </button>
            }
        </div>
    </div>
}

@code {
    bool isAdmin => State.Auth?.RoleName == RoleNames.Admin;
    bool isKpp => State.Auth?.CanManageEntry == true && !isAdmin;

    string purpose = "", host = "", carBrand = "", carPlate = "",
           fullName = "", dob = "", passport = "", nationality = "РФ";
    DateOnly plannedDate = DateOnly.FromDateTime(DateTime.Today);
    string? passportScanBase64, permitDocBase64;
    bool permitDocLoaded = false;
    bool groupMode = false, submitting = false, showSuccess = false;
    int successCount = 1;
    string errMsg = "", scanMsg = "", scanMsgColor = "var(--accent-text)";
    List<MemberForm> members = new() { new MemberForm() };

    // Validation state
    bool purposeError = false;
    bool hostError = false;
    bool nameError = false;

    // OCR state
    string ocrStatus = "";  // "", "scanning", "done", "error"
    int ocrFieldsFilled = 0;
    string ocrMethod = "";  // "ai-vision" or "tesseract-v2"
    DotNetObjectReference<Register>? ocrRef;

    string bannerCls => isAdmin ? "info-banner banner-admin" : isKpp ? "info-banner banner-kpp" : "info-banner banner-user";
    string bannerTxt => isAdmin ? Loc["register.banner.admin"]
                     : isKpp ? Loc["register.banner.kpp"]
                     : Loc["register.banner.user"];
    string submitLabel => isAdmin ? Loc["register.create"] : isKpp ? Loc["register.submitKpp"] : Loc["register.submitUser"];

    void CloseSuccess()
    {
        showSuccess = false;
        State.Navigate(State.Auth?.CanViewHistory == true ? "history" : "register");
    }

    void ResetForm()
    {
        purpose = host = carBrand = carPlate = fullName = dob = passport = "";
        nationality = "РФ";
        plannedDate = DateOnly.FromDateTime(DateTime.Today);
        passportScanBase64 = permitDocBase64 = null;
        permitDocLoaded = false;
        groupMode = false;
        members = new() { new MemberForm() };
        errMsg = scanMsg = "";
        purposeError = hostError = nameError = false;
        ocrStatus = "";
        ocrFieldsFilled = 0;
        ocrMethod = "";
    }

    void SwitchMode(bool grp)
    {
        groupMode = grp;
        if (grp) { fullName = ""; dob = ""; passport = ""; nationality = ""; }
        nameError = false;
        StateHasChanged();
    }
    void AddMember() => members.Add(new MemberForm());
    void RemoveMember(int i) => members.RemoveAt(i);

    void OnCarPlateInput(string? val) =>
        carPlate = (val ?? string.Empty).ToUpperInvariant();

    void SetMemberNationality(MemberForm m, string? val) =>
        m.Nationality = string.IsNullOrEmpty(val) ? "КР" : val;

    const long MaxFileBytes = 10_000_000;

    async Task OnPassportScan(InputFileChangeEventArgs e)
    {
        try
        {
            var f = e.File;
            if (f.Size > MaxFileBytes)
            {
                scanMsg = $"Файл слишком большой ({f.Size / 1_048_576} МБ). Максимум 10 МБ.";
                scanMsgColor = "var(--bad-text)";
                return;
            }
            scanMsg = "Загружено..."; scanMsgColor = "var(--accent-text)";
            StateHasChanged();
            using var ms = new MemoryStream();
            await f.OpenReadStream(MaxFileBytes).CopyToAsync(ms);
            passportScanBase64 = "data:" + f.ContentType + ";base64," + Convert.ToBase64String(ms.ToArray());
            scanMsg = "Скан загружен"; scanMsgColor = "var(--good-text)";

            // Auto-run OCR if it's an image
            if (f.ContentType.StartsWith("image/"))
            {
                _ = RunOcrAsync(passportScanBase64);
            }
        }
        catch (Exception ex)
        {
            scanMsg = ex.Message;
            scanMsgColor = "var(--bad-text)";
        }
    }

    async Task RunOcrAsync(string imageDataUrl)
    {
        try
        {
            ocrStatus = "scanning";
            ocrFieldsFilled = 0;
            StateHasChanged();

            ocrRef = DotNetObjectReference.Create(this);
            var json = await JS.InvokeAsync<string>("passportOcr.scanPassport", imageDataUrl, ocrRef);
            var result = System.Text.Json.JsonDocument.Parse(json);
            var root = result.RootElement;

            if (root.TryGetProperty("error", out var errProp))
            {
                ocrStatus = "error";
                StateHasChanged();
                return;
            }

            // Auto-fill fields — always overwrite with new scan data
            int filled = 0;
            if (root.TryGetProperty("fullName", out var fn))
            {
                var v = fn.GetString() ?? "";
                if (!string.IsNullOrWhiteSpace(v)) { fullName = v; nameError = false; filled++; }
            }
            if (root.TryGetProperty("dob", out var db))
            {
                var v = db.GetString() ?? "";
                if (!string.IsNullOrWhiteSpace(v)) { dob = v; filled++; }
            }
            if (root.TryGetProperty("passport", out var pp))
            {
                var v = pp.GetString() ?? "";
                if (!string.IsNullOrWhiteSpace(v)) { passport = v; filled++; }
            }
            if (root.TryGetProperty("nationality", out var nat))
            {
                var v = nat.GetString() ?? "";
                if (!string.IsNullOrWhiteSpace(v)) { nationality = v; filled++; }
            }
            if (root.TryGetProperty("gender", out var gen))
            {
                var v = gen.GetString() ?? "";
                if (!string.IsNullOrWhiteSpace(v)) { filled++; }
            }

            // Track which method was used
            if (root.TryGetProperty("method", out var mth))
                ocrMethod = mth.GetString() ?? "";
            else ocrMethod = "";

            ocrFieldsFilled = filled;
            ocrStatus = filled > 0 ? "done" : "error";
            StateHasChanged();

            // Trigger auto-fill flash animation on filled inputs
            if (filled > 0)
            {
                try { await JS.InvokeVoidAsync("triggerAutoFillFlash"); } catch { }
            }
        }
        catch
        {
            ocrStatus = "error";
            StateHasChanged();
        }
    }

    // JSInvokable callback for OCR status
    [JSInvokable]
    public void OnOcrStatusChanged(string status)
    {
        // Status updates come from JS during scanning
        // We use this for real-time progress but main status is set in RunOcrAsync
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        ocrRef?.Dispose();
    }

    async Task OnPermitDoc(InputFileChangeEventArgs e)
    {
        try
        {
            var f = e.File;
            if (f.Size > MaxFileBytes)
            {
                errMsg = $"Документ слишком большой ({f.Size / 1_048_576} МБ). Максимум 10 МБ.";
                return;
            }
            using var ms = new MemoryStream();
            await f.OpenReadStream(MaxFileBytes).CopyToAsync(ms);
            permitDocBase64 = "data:" + f.ContentType + ";base64," + Convert.ToBase64String(ms.ToArray());
            permitDocLoaded = true;
            errMsg = "";
        }
        catch (Exception ex)
        {
            errMsg = "Не удалось загрузить: " + ex.Message;
            permitDocLoaded = false;
        }
    }

    string FormatDob(string raw)
    {
        var d = new string(raw.Where(char.IsDigit).ToArray());
        var r = "";
        for (int i = 0; i < d.Length && i < 8; i++)
        {
            if (i == 2 || i == 4) r += ".";
            r += d[i];
        }
        return r;
    }

    /// <summary>Проверяет корректность формата даты рождения ДД.ММ.ГГГГ.</summary>
    static bool IsValidDobFormat(string dob)
    {
        if (string.IsNullOrWhiteSpace(dob)) return true; // необязательное поле
        // Допускаем частичный ввод
        var digits = new string(dob.Where(char.IsDigit).ToArray());
        if (digits.Length != 8) return true; // ещё вводится
        // Полная дата — проверим валидность
        if (DateTime.TryParseExact(dob, "dd.MM.yyyy", null, System.Globalization.DateTimeStyles.None, out var dt))
            return dt.Year >= 1900 && dt <= DateTime.Today;
        return false;
    }

    async Task Submit()
    {
        errMsg = "";
        purposeError = hostError = nameError = false;

        // Валидация обязательных полей
        if (string.IsNullOrWhiteSpace(purpose))
        {
            errMsg = "Укажите цель визита";
            purposeError = true;
            return;
        }
        if (string.IsNullOrWhiteSpace(host))
        {
            errMsg = "Укажите принимающее лицо";
            hostError = true;
            return;
        }
        if (groupMode && members.Any(m => string.IsNullOrWhiteSpace(m.FullName)))
        {
            errMsg = "Введите ФИО для всех гостей";
            return;
        }
        if (!groupMode && string.IsNullOrWhiteSpace(fullName))
        {
            errMsg = "Введите ФИО гостя";
            nameError = true;
            return;
        }

        // Валидация формата даты рождения
        if (!IsValidDobFormat(dob))
        {
            errMsg = "Некорректная дата рождения. Используйте формат ДД.ММ.ГГГГ";
            return;
        }

        // Валидация длины ФИО (минимум 2 слова для "Фамилия Имя")
        if (!groupMode && !string.IsNullOrWhiteSpace(fullName))
        {
            var words = fullName.Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
            if (words.Length < 2)
            {
                errMsg = "Введите хотя бы Фамилию и Имя";
                nameError = true;
                return;
            }
        }

        // Валидация номера авто (если указан)
        if (!string.IsNullOrWhiteSpace(carPlate) && carPlate.Length < 4)
        {
            errMsg = "Слишком короткий номер автомобиля";
            return;
        }

        // Валидация паспорта (если указан)
        if (!string.IsNullOrWhiteSpace(passport) && passport.Replace(" ", "").Length < 6)
        {
            errMsg = "Номер паспорта должен содержать минимум 6 символов";
            return;
        }

        submitting = true;
        var groupId = groupMode ? "G" + DateTimeOffset.UtcNow.ToUnixTimeMilliseconds() : null;
        try
        {
            var author = State.Auth?.Username ?? "system";
            if (groupMode)
            {
                foreach (var m in members)
                {
                    await Api.CreateGuestAsync(new GuestCreateRequest
                    {
                        FullName    = m.FullName,
                        Dob         = m.Dob.NullIfEmpty(),
                        Passport    = m.Passport.NullIfEmpty(),
                        Nationality = m.Nationality.NullIfEmpty() ?? "КР",
                        Purpose     = purpose,
                        Host        = host,
                        CarBrand    = carBrand.NullIfEmpty(),
                        CarPlate    = carPlate.NullIfEmpty(),
                        PlannedDate = plannedDate.ToString("yyyy-MM-dd"),
                        GroupId     = groupId
                    }, author, isKpp);
                }
                successCount = members.Count;
            }
            else
            {
                await Api.CreateGuestAsync(new GuestCreateRequest
                {
                    FullName           = fullName,
                    Dob                = dob.NullIfEmpty(),
                    Passport           = passport.NullIfEmpty(),
                    Nationality        = nationality.NullIfEmpty() ?? "КР",
                    Purpose            = purpose,
                    Host               = host,
                    CarBrand           = carBrand.NullIfEmpty(),
                    CarPlate           = carPlate.NullIfEmpty(),
                    PassportScanBase64 = passportScanBase64,
                    PermitDocBase64    = permitDocBase64,
                    PlannedDate        = plannedDate.ToString("yyyy-MM-dd")
                }, author, isKpp);
                successCount = 1;
            }
            showSuccess = true;
        }
        catch (Exception e) { errMsg = e.Message; }
        finally { submitting = false; }
    }
}
