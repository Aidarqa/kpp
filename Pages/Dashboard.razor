@namespace KppBlazor.Pages
@page "/"
@page "/dashboard"
@using KppBlazor.Services
@using KppBlazor.Models
@inject ApiService Api
@inject AppState State
@inject ThemeService Theme
@inject LocalizationService Loc
@inject IJSRuntime JS
@inject NavigationManager Nav
@implements IDisposable

<div class="page-fill">
    <!-- Header -->
    <div class="page-header">
        <div style="display:flex;align-items:center;gap:14px">
            <div class="page-title-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>
                </svg>
            </div>
            <div>
                <div class="page-title">@Loc["dashboard.title"]</div>
                <div class="page-subtitle">@Loc["dashboard.subtitle"]</div>
            </div>
        </div>
    </div>

    @if (stats == null)
    {
        <div class="loading" style="padding:60px">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="spin"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
            @Loc["history.loading"]
        </div>
    }
    else
    {
        <!-- Stats Cards -->
        <div class="dash-cards">
            <button class="dash-card dash-card-accent" @onclick='() => GoToHistory(GuestStatus.Inside)'>
                <div class="dash-card-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
                    </svg>
                </div>
                <div class="dash-card-val">@stats.InsideCount</div>
                <div class="dash-card-lbl">@Loc["dashboard.inside"]</div>
                <div class="dash-card-pulse"></div>
            </button>
            <button class="dash-card dash-card-green" @onclick='() => GoToHistory("today")'>
                <div class="dash-card-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/>
                    </svg>
                </div>
                <div class="dash-card-val">@stats.TodayCount</div>
                <div class="dash-card-lbl">@Loc["dashboard.today"]</div>
            </button>
            <button class="dash-card dash-card-blue" @onclick='() => GoToHistory("week")'>
                <div class="dash-card-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
                    </svg>
                </div>
                <div class="dash-card-val">@stats.WeekCount</div>
                <div class="dash-card-lbl">@Loc["dashboard.week"]</div>
            </button>
            <button class="dash-card dash-card-warn" @onclick='() => GoToHistory(GuestStatus.Pending)'>
                <div class="dash-card-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                    </svg>
                </div>
                <div class="dash-card-val">@stats.PendingCount</div>
                <div class="dash-card-lbl">@Loc["dashboard.pending"]</div>
            </button>
        </div>

        <!-- Charts Row -->
        <div class="dash-row">
            <!-- Weekly Visits Mini Chart -->
            <div class="card dash-chart-card">
                <div class="dash-section-title">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/></svg>
                    @Loc["dashboard.visits"]
                </div>
                <div class="mini-chart">
                    @foreach (var d in stats.WeeklyVisits)
                    {
                        var maxVal = Math.Max(stats.WeeklyVisits.Max(v => v.Count), 1);
                        var heightPct = (int)((double)d.Count / maxVal * 100);
                        <div class="chart-bar-group">
                            <div class="chart-bar-val">@(d.Count > 0 ? d.Count.ToString() : "")</div>
                            <div class="chart-bar-wrap">
                                <div class="chart-bar" style="height:@Math.Max(heightPct, 4)%"></div>
                            </div>
                            <div class="chart-bar-label">@d.DayName</div>
                        </div>
                    }
                </div>
            </div>

            <!-- Peak Hours -->
            <div class="card dash-chart-card">
                <div class="dash-section-title">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    @Loc["dashboard.peaks"]
                </div>
                <div class="peak-hours">
                    @foreach (var p in stats.HourlyPeaks.OrderByDescending(h => h.Count).Take(6))
                    {
                        var maxVal = Math.Max(stats.HourlyPeaks.Max(h => h.Count), 1);
                        var widthPct = (int)((double)p.Count / maxVal * 100);
                        <div class="peak-row">
                            <span class="peak-hour">@p.Hour:00</span>
                            <div class="peak-bar-wrap">
                                <div class="peak-bar" style="width:@Math.Max(widthPct, 8)%"></div>
                            </div>
                            <span class="peak-count">@p.Count</span>
                        </div>
                    }
                    @if (!stats.HourlyPeaks.Any())
                    {
                        <div style="color:var(--text-dim);text-align:center;padding:20px;font-size:13px">—</div>
                    }
                </div>
            </div>
        </div>

        <!-- Pending Guests + Recent Actions -->
        <div class="dash-row">
            <!-- Pending Guests -->
            <div class="card dash-list-card">
                <div class="dash-section-title">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    @Loc["dashboard.waiting"]
                    @if (pendingGuests.Any()) { <span class="dash-badge">@pendingGuests.Count</span> }
                </div>
                @if (!pendingGuests.Any())
                {
                    <div class="dash-empty">@Loc["dashboard.noPending"]</div>
                }
                else
                {
                    @foreach (var g in pendingGuests.Take(5))
                    {
                        <div class="dash-guest-row">
                            <div class="dash-guest-info">
                                <div class="dash-guest-name">@g.FullName</div>
                                <div class="dash-guest-meta">
                                    @g.Purpose
                                    @if (!string.IsNullOrEmpty(g.Host)) { <span> → @g.Host</span> }
                                </div>
                            </div>
                            @if (canManage)
                            {
                                <button class="btn-entry" @onclick="() => QuickEntry(g)">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                                    @Loc["action.entry"]
                                </button>
                            }
                        </div>
                    }
                }
            </div>

            <!-- Recent Actions -->
            <div class="card dash-list-card">
                <div class="dash-section-title">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                    @Loc["dashboard.recent"]
                </div>
                @if (!auditLog.Any())
                {
                    <div class="dash-empty">@Loc["dashboard.noActions"]</div>
                }
                else
                {
                    @foreach (var a in auditLog.Take(8))
                    {
                        <div class="dash-audit-row">
                            <div class="dash-audit-icon @GetActionClass(a.Action)">
                                @GetActionIcon(a.Action)
                            </div>
                            <div class="dash-audit-info">
                                <div class="dash-audit-desc">@a.Description</div>
                                <div class="dash-audit-meta">@a.PerformedBy · @FmtTime(a.Timestamp)</div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    }
</div>

<!-- Confetti overlay -->
@if (showConfetti)
{
    <div class="confetti-overlay">
        <div class="confetti-success-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"/>
            </svg>
        </div>
        @for (int i = 0; i < 20; i++)
        {
            <div class="confetti-piece" style="--cf-delay:@(i * 0.05)s;--cf-x:@(Random.Shared.Next(-100, 100))px;--cf-rotate:@(Random.Shared.Next(0, 360))deg;--cf-color:@GetConfettiColor(i)"></div>
        }
    </div>
}

@code {
    DashboardStats? stats;
    List<GuestItem> pendingGuests = new();
    List<AuditLogEntry> auditLog = new();
    bool showConfetti = false;
    int _prevPendingCount = 0;

    bool canManage => State.Auth?.CanManageEntry == true;
    bool isAdmin => State.Auth?.RoleName == RoleNames.Admin;

    protected override async Task OnInitializedAsync()
    {
        State.OnChange += StateHasChanged;
        Theme.OnChange += StateHasChanged;
        await LoadData();
        // Request notification permission
        try { await JS.InvokeVoidAsync("requestNotificationPermission"); } catch { }
    }

    public void Dispose()
    {
        State.OnChange -= StateHasChanged;
        Theme.OnChange -= StateHasChanged;
    }

    async Task LoadData()
    {
        try
        {
            stats = await Api.GetDashboardStatsAsync();
            var allGuests = await Api.GetGuestsAsync();
            pendingGuests = allGuests.Items.Where(g => g.Status == GuestStatus.Pending).ToList();
            auditLog = await Api.GetAuditLogAsync(20);

            // Push notification when new pending guests appear
            if (_prevPendingCount > 0 && pendingGuests.Count > _prevPendingCount)
            {
                var newCount = pendingGuests.Count - _prevPendingCount;
                try
                {
                    await JS.InvokeVoidAsync("sendNotification",
                        "КПП — Новый гость",
                        $"{newCount} новых гостей ожидают на КПП");
                } catch { }
            }
            _prevPendingCount = pendingGuests.Count;
        }
        catch { }
    }

    async Task QuickEntry(GuestItem g)
    {
        await Api.GuestEntryAsync(g.Id);
        showConfetti = true;
        StateHasChanged();
        _ = Task.Delay(2000).ContinueWith(_ =>
        {
            showConfetti = false;
            InvokeAsync(async () => { await LoadData(); StateHasChanged(); });
        });
    }

    void GoToHistory(string filter)
    {
        State.SetHistoryFilter(filter);
        Nav.NavigateTo("/history");
    }

    static string FmtTime(DateTime dt)
    {
        if (dt.Date == DateTime.Today) return dt.ToString("HH:mm");
        return dt.ToString("dd.MM HH:mm");
    }

    string GetActionClass(string action) => action switch
    {
        "entry" or "register" => "audit-green",
        "exit" => "audit-red",
        "create" => "audit-blue",
        _ => "audit-neutral"
    };

    string GetActionIcon(string action) => action switch
    {
        "entry" or "register" => "▶",
        "exit" => "■",
        "create" => "✎",
        _ => "•"
    };

    string GetConfettiColor(int i)
    {
        var colors = new[] { "#06b6d4", "#8b5cf6", "#10b981", "#f59e0b", "#f43f5e", "#3b82f6" };
        return colors[i % colors.Length];
    }
}
