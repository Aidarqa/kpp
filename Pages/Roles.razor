
@using KppBlazor.Services
@using KppBlazor.Models
@inject ApiService Api
@inject AppState State

<div class="page-fill">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;flex-wrap:wrap;gap:12px">
        <div style="display:flex;align-items:center;gap:14px">
            <div class="page-title-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/>
                </svg>
            </div>
            <div class="page-title" style="margin:0">Роли и права</div>
        </div>
        <button class="btn-primary" @onclick="ToggleCreate">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Создать роль
        </button>
    </div>

    @if (!string.IsNullOrEmpty(flashMsg))
    {
        <div class="msg-ok">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
            @flashMsg
        </div>
    }

    <div class="table-wrap table-fill">
        @if (loading)
        {
            <div class="loading">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="spin"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
                Загрузка...
            </div>
        }
        else if (!string.IsNullOrEmpty(loadErr))
        {
            <div class="err-banner" style="margin:20px">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                @loadErr
            </div>
        }
        else
        {
            <table>
                <thead>
                    <tr>
                        @foreach (var h in new[] { "Название", "Системное имя", "Заявки", "История", "Вход/Выход", "Действия" })
                        {
                            <th>@h</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in roles)
                    {
                        <tr>
                            <td>
                                @if (editingId == r.Id)
                                {
                                    <input class="input" style="font-size:13px;min-width:120px" @bind="editDisplayName" @bind:event="oninput" />
                                }
                                else
                                {
                                    <b style="color:var(--text)">@r.DisplayName</b>
                                    @if (r.IsSystem)
                                    {
                                        <span style="display:inline-flex;align-items:center;gap:3px;background:var(--surface-3);color:var(--text-muted);font-size:9px;border-radius:4px;padding:1px 6px;margin-left:6px;border:1px solid var(--border)">
                                            <svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                                            системная
                                        </span>
                                    }
                                }
                            </td>
                            <td><code style="color:var(--accent-text);font-size:12px;font-family:'JetBrains Mono',monospace">@r.Name</code></td>
                            @foreach (var (key, _) in Perms)
                            {
                                var k = key;
                                <td style="text-align:center">
                                    @if (editingId == r.Id && !r.IsSystem)
                                    {
                                        <input type="checkbox" checked="@GetEditPerm(k)" @onchange="e => SetEditPerm(k, (bool)(e.Value ?? false))" style="accent-color:var(--accent);width:16px;height:16px;cursor:pointer" />
                                    }
                                    else
                                    {
                                        @if (GetRolePerm(r, k))
                                        {
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--good-text)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                                        }
                                        else
                                        {
                                            <span style="color:var(--text-dim)">—</span>
                                        }
                                    }
                                </td>
                            }
                            <td>
                                @if (r.IsSystem)
                                {
                                    <span style="color:var(--text-dim);font-size:12px;display:flex;align-items:center;gap:4px">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                                        защищена
                                    </span>
                                }
                                else if (editingId == r.Id)
                                {
                                    <div class="act-row">
                                        <button class="btn-sm btn-sm-green" @onclick="() => SaveEdit(r.Id)">
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                                            Сохранить
                                        </button>
                                        <button class="btn-sm" style="background:var(--surface-2);color:var(--text-dim);border:1px solid var(--border)"
                                                @onclick="CancelEdit">Отмена</button>
                                    </div>
                                }
                                else
                                {
                                    <div class="act-row">
                                        <button class="btn-sm btn-sm-blue" @onclick="() => StartEdit(r)">
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                            Изменить
                                        </button>
                                        <button class="btn-sm-del" @onclick="() => DeleteRole(r)">
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                                        </button>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<!-- Модалка создания роли -->
@if (showCreate)
{
    <div class="modal-bg" @onclick="() => showCreate = false">
        <div class="modal-box" style="max-width:460px" @onclick:stopPropagation="true">
            <div class="modal-hdr">
                <span class="modal-hdr-title">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/></svg>
                    Новая роль
                </span>
                <button class="modal-close" @onclick="() => showCreate = false">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>
            </div>

            <div class="form-grid" style="margin-bottom:16px">
                <div class="form-group">
                    <label class="lbl">Системное имя</label>
                    <input class="input" placeholder="security" value="@cf_name"
                           @oninput="e => OnRoleNameInput(e.Value?.ToString())" />
                    <span style="color:var(--text-dim);font-size:11px;margin-top:4px">Латиница, без пробелов</span>
                </div>
                <div class="form-group">
                    <label class="lbl">Название</label>
                    <input class="input" placeholder="Служба охраны" @bind="cf_displayName" @bind:event="oninput" />
                </div>
            </div>

            <div style="background:var(--surface-2);border-radius:14px;padding:18px;margin-bottom:16px;border:1px solid var(--border)">
                <div style="color:var(--text-muted);font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;margin-bottom:14px">Права доступа</div>
                @foreach (var (key, label) in Perms)
                {
                    var k = key;
                    <div class="check-wrap">
                        <input type="checkbox" checked="@GetPerm(k)" @onchange="e => SetPerm(k, (bool)(e.Value ?? false))" />
                        <span>@label</span>
                    </div>
                }
            </div>

            @if (!string.IsNullOrEmpty(createErr))
            {
                <div class="err-banner" style="margin-bottom:14px">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    @createErr
                </div>
            }

            <div style="display:flex;gap:10px;justify-content:flex-end">
                <button style="background:none;border:1px solid var(--border);border-radius:12px;padding:10px 20px;color:var(--text-muted);cursor:pointer;font-size:13px;transition:all .2s"
                        @onclick="() => showCreate = false">
                    Отмена
                </button>
                <button class="btn-primary" @onclick="CreateRole">Создать роль</button>
            </div>
        </div>
    </div>
}

@code {
    static readonly (string key, string label)[] Perms =
    {
        ("canCreateRequest", "Создавать заявки"),
        ("canViewHistory",   "Просматривать историю"),
        ("canManageEntry",   "Вход / Выход (КПП)")
    };

    List<RoleItem> roles = new();
    bool loading = false, showCreate = false;
    string loadErr = "", createErr = "", flashMsg = "";
    int editingId = -1;

    string cf_name = "", cf_displayName = "";
    Dictionary<string, bool> cf_perms = new()
    { ["canCreateRequest"] = true, ["canViewHistory"] = false, ["canManageEntry"] = false };

    string editDisplayName = "";
    Dictionary<string, bool> edit_perms = new();

    void OnRoleNameInput(string? val) =>
        cf_name = (val ?? string.Empty).ToLower().Replace(' ', '_');

    bool GetPerm(string k) => cf_perms.TryGetValue(k, out var v) && v;
    void SetPerm(string k, bool v) => cf_perms[k] = v;
    bool GetEditPerm(string k) => edit_perms.TryGetValue(k, out var v) && v;
    void SetEditPerm(string k, bool v) => edit_perms[k] = v;
    bool GetRolePerm(RoleItem r, string k) => k switch
    {
        "canCreateRequest" => r.CanCreateRequest,
        "canViewHistory"   => r.CanViewHistory,
        "canManageEntry"   => r.CanManageEntry,
        _                  => false
    };

    protected override async Task OnInitializedAsync() => await LoadRoles();

    async Task LoadRoles()
    {
        loading = true; loadErr = "";
        try { roles = await Api.GetRolesAsync(); State.RolesCache = roles; }
        catch (Exception e) { loadErr = e.Message; }
        finally { loading = false; }
    }

    void ToggleCreate()
    {
        cf_name = cf_displayName = "";
        cf_perms = new() { ["canCreateRequest"] = true, ["canViewHistory"] = false, ["canManageEntry"] = false };
        createErr = "";
        showCreate = true;
    }

    async Task CreateRole()
    {
        createErr = "";
        if (string.IsNullOrWhiteSpace(cf_name) || string.IsNullOrWhiteSpace(cf_displayName))
        { createErr = "Заполните поля"; return; }
        try
        {
            await Api.CreateRoleAsync(
                cf_name, cf_displayName,
                cf_perms["canCreateRequest"],
                cf_perms["canViewHistory"],
                cf_perms["canManageEntry"]);
            showCreate = false;
            await LoadRoles();
            Flash("Роль создана");
        }
        catch (Exception e) { createErr = e.Message; }
    }

    void StartEdit(RoleItem r)
    {
        editingId = r.Id; editDisplayName = r.DisplayName;
        edit_perms = new()
        {
            ["canCreateRequest"] = r.CanCreateRequest,
            ["canViewHistory"]   = r.CanViewHistory,
            ["canManageEntry"]   = r.CanManageEntry
        };
    }

    void CancelEdit() => editingId = -1;

    async Task SaveEdit(int id)
    {
        try
        {
            // Используем UpdateRoleDisplayNameAsync — только DisplayName и права,
            // не перезаписываем системное имя роли
            await Api.UpdateRoleDisplayNameAsync(
                id, editDisplayName,
                edit_perms["canCreateRequest"],
                edit_perms["canViewHistory"],
                edit_perms["canManageEntry"]);
            editingId = -1;
            await LoadRoles();
            Flash("Роль обновлена");
        }
        catch (Exception e) { loadErr = e.Message; }
    }

    async Task DeleteRole(RoleItem r)
    {
        try { await Api.DeleteRoleAsync(r.Id); await LoadRoles(); Flash("Роль удалена"); }
        catch (Exception e) { loadErr = e.Message; }
    }

    void Flash(string msg)
    {
        flashMsg = msg;
        _ = Task.Delay(3000).ContinueWith(_ => { flashMsg = ""; InvokeAsync(StateHasChanged); });
    }
}
