@namespace KppBlazor.Shared
@using KppBlazor.Services
@inject AppState State
@inject ThemeService Theme
@inject IJSRuntime JS
@implements IDisposable

<div id="sidebar">

    <!-- Бренд -->
    <div class="sb-brand">
        <div class="sb-brand-inner">
            <div class="sb-logo">🛡️</div>
            <div>
                <div class="sb-name">КПП</div>
                <div class="sb-sub">Контроль гостей</div>
            </div>
        </div>
    </div>

    <!-- Пользователь -->
    <div style="padding:12px 12px 4px">
        <div class="sb-user">
            <div class="sb-avatar">👤</div>
            <div style="min-width:0">
                <div class="sb-uname" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
                    @State.Auth?.DisplayName
                </div>
                <div class="sb-urole">
                    @if (isAdmin) { <span>⭐ Администратор</span> }
                    else { <span>@State.Auth?.RoleName</span> }
                </div>
            </div>
        </div>
    </div>

    <!-- Навигация -->
    <nav>
        <div class="nav-section-label">Меню</div>

        @if (State.Auth?.CanViewHistory == true)
        {
            <button class="nav-btn @(State.CurrentView == "history" ? "active" : "")"
                    @onclick='async () => await Navigate("history")'>
                <span class="nav-icon">📋</span>
                <span style="flex:1">История</span>
                @if (State.Auth?.CanManageEntry == true && State.Stats.PendingCnt > 0)
                {
                    <span class="nav-badge">@State.Stats.PendingCnt</span>
                }
            </button>
        }

        @if (State.Auth?.CanCreateRequest == true)
        {
            <button class="nav-btn @(State.CurrentView == "register" ? "active" : "")"
                    @onclick='async () => await Navigate("register")'>
                <span class="nav-icon">@(isAdmin ? "📝" : "✍️")</span>
                <span>@(isAdmin ? "Новая заявка" : "Создать заявку")</span>
            </button>
        }

        @if (isAdmin)
        {
            <div class="nav-section-label" style="margin-top:4px">Администрирование</div>
            <button class="nav-btn @(State.CurrentView == "users" ? "active" : "")"
                    @onclick='async () => await Navigate("users")'>
                <span class="nav-icon">👥</span>
                <span>Пользователи</span>
            </button>
            <button class="nav-btn @(State.CurrentView == "roles" ? "active" : "")"
                    @onclick='async () => await Navigate("roles")'>
                <span class="nav-icon">🔑</span>
                <span>Роли и права</span>
            </button>
        }
    </nav>

    <!-- Статистика -->
    @if (State.Auth?.CanViewHistory == true)
    {
        <div style="padding:0 12px 4px">
            <div class="nav-section-label">Статистика</div>
        </div>
        <div class="sb-stats">
            <div class="stat-card">
                <div class="stat-num" style="color:var(--accent-text)">@State.Stats.InsideCnt</div>
                <div class="stat-lbl">Внутри</div>
            </div>
            <div class="stat-card">
                <div class="stat-num" style="color:var(--good-text)">@State.Stats.TodayCnt</div>
                <div class="stat-lbl">Сегодня</div>
            </div>
            @if (State.Stats.PendingCnt > 0)
            {
                <div class="stat-card">
                    <div class="stat-num" style="color:var(--warn-text)">@State.Stats.PendingCnt</div>
                    <div class="stat-lbl">Ожидается</div>
                </div>
            }
            <div class="stat-card" style="grid-column:@(State.Stats.PendingCnt > 0 ? "auto" : "span 2")">
                <div class="stat-num" style="color:var(--text-muted)">@State.Stats.Total</div>
                <div class="stat-lbl">Всего</div>
            </div>
        </div>
    }

    <!-- Тема + Выход -->
    <div class="sb-footer">
        <button class="btn-mode-toggle" @onclick="ToggleTheme">
            <span class="mode-icon">@(Theme.IsDark ? "☀️" : "🌙")</span>
            <span>@(Theme.IsDark ? "Светлая тема" : "Тёмная тема")</span>
        </button>
        <button class="btn-logout" @onclick="async () => await Logout()">
            <span>←</span> Выйти
        </button>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnClose { get; set; }

    bool isAdmin => State.Auth?.RoleName == "admin";

    protected override void OnInitialized()
    {
        State.OnChange += StateHasChanged;
        Theme.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        State.OnChange -= StateHasChanged;
        Theme.OnChange -= StateHasChanged;
    }

    async Task Navigate(string view)
    {
        State.Navigate(view);
        await OnClose.InvokeAsync();
    }

    async Task Logout()
    {
        try { await JS.InvokeVoidAsync("localStorage.removeItem", "kpp-auth"); } catch { }
        State.Logout();
    }

    async Task ToggleTheme() => await Theme.ToggleAsync();
}
