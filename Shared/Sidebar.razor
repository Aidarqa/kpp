@namespace KppBlazor.Shared
@using KppBlazor.Services
@inject AppState State
@inject ThemeService Theme
@inject LocalizationService Loc
@inject IJSRuntime JS
@implements IDisposable

<div id="sidebar">

    <!-- Бренд -->
    <div class="sb-brand" @onclick='async () => await Navigate("dashboard")' title="@Loc["dashboard.title"]">
        <div class="sb-brand-inner">
            <div class="sb-logo">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                </svg>
            </div>
            <div>
                <div class="sb-name">КПП</div>
                <div class="sb-sub">Контроль гостей</div>
            </div>
        </div>
    </div>

    <!-- Пользователь -->
    <div style="padding:12px 14px 4px">
        <div class="sb-user">
            <div class="sb-avatar">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                    <circle cx="12" cy="7" r="4"/>
                </svg>
            </div>
            <div style="min-width:0">
                <div class="sb-uname" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
                    @State.Auth?.DisplayName
                </div>
                <div class="sb-urole">
                    @if (isAdmin) {
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                        <span>@Loc["nav.admin"]</span>
                    }
                    else { <span>@State.Auth?.RoleName</span> }
                </div>
            </div>
        </div>
    </div>

    <!-- Навигация -->
    <nav>
        <div class="nav-section-label">@Loc["nav.menu"]</div>

        @if (State.Auth?.CanViewHistory == true)
        {
            <button class="nav-btn @(State.CurrentView == "dashboard" ? "active" : "")"
                    @onclick='async () => await Navigate("dashboard")'>
                <span class="nav-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>
                    </svg>
                </span>
                <span style="flex:1">@Loc["dashboard.title"]</span>
            </button>
            <button class="nav-btn @(State.CurrentView == "history" ? "active" : "")"
                    @onclick='async () => await Navigate("history")'>
                <span class="nav-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                    </svg>
                </span>
                <span style="flex:1">@Loc["nav.history"]</span>
                @if (State.Auth?.CanManageEntry == true && State.Stats.PendingCnt > 0)
                {
                    <span class="nav-badge">@State.Stats.PendingCnt</span>
                }
            </button>
        }

        @if (State.Auth?.CanCreateRequest == true)
        {
            <button class="nav-btn @(State.CurrentView == "register" ? "active" : "")"
                    @onclick='async () => await Navigate("register")'>
                <span class="nav-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                    </svg>
                </span>
                <span>@(isAdmin ? Loc["nav.register"] : Loc["register.title.user"])</span>
            </button>
        }

        @if (isAdmin)
        {
            <div class="nav-section-label" style="margin-top:4px">@Loc["nav.admin"]</div>
            <button class="nav-btn @(State.CurrentView == "users" ? "active" : "")"
                    @onclick='async () => await Navigate("users")'>
                <span class="nav-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                        <circle cx="9" cy="7" r="4"/>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                    </svg>
                </span>
                <span>@Loc["nav.users"]</span>
            </button>
            <button class="nav-btn @(State.CurrentView == "roles" ? "active" : "")"
                    @onclick='async () => await Navigate("roles")'>
                <span class="nav-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/>
                    </svg>
                </span>
                <span>@Loc["nav.roles"]</span>
            </button>
        }
    </nav>

    <!-- Статистика -->
    @if (State.Auth?.CanViewHistory == true)
    {
        <div style="padding:0 14px 4px">
            <div class="nav-section-label">@Loc["nav.stats"]</div>
        </div>
        <div class="sb-stats">
            <div class="stat-card">
                <div class="stat-num" style="color:var(--accent-text)">@State.Stats.InsideCnt</div>
                <div class="stat-lbl">@Loc["dashboard.inside"]</div>
            </div>
            <div class="stat-card">
                <div class="stat-num" style="color:var(--good-text)">@State.Stats.TodayCnt</div>
                <div class="stat-lbl">@Loc["dashboard.today"]</div>
            </div>
            @if (State.Stats.PendingCnt > 0)
            {
                <div class="stat-card">
                    <div class="stat-num" style="color:var(--warn-text)">@State.Stats.PendingCnt</div>
                    <div class="stat-lbl">@Loc["dashboard.pending"]</div>
                </div>
            }
            <div class="stat-card" style="grid-column:@(State.Stats.PendingCnt > 0 ? "auto" : "span 2")">
                <div class="stat-num" style="color:var(--text-muted)">@State.Stats.Total</div>
                <div class="stat-lbl">@Loc["dashboard.total"]</div>
            </div>
        </div>
    }

    <!-- Настройки: тема, акцент, язык -->
    <div class="sb-footer">
        <!-- Accent Colors -->
        <div class="sb-settings-section">
            <div class="sb-settings-label">@Loc["theme.accent"]</div>
            <div class="accent-picker">
                @foreach (var a in ThemeService.Accents)
                {
                    var name = a.Name;
                    <button class="accent-dot @(Theme.Accent == name ? "active" : "")"
                            style="background:@a.Primary"
                            @onclick="async () => await Theme.SetAccentAsync(name)"
                            title="@a.Label"></button>
                }
            </div>
        </div>
        <!-- Language -->
        <div class="sb-settings-section">
            <div class="sb-settings-label">🌐</div>
            <div class="lang-picker">
                <button class="lang-btn @(Loc.CurrentLang == "ru" ? "active" : "")"
                        @onclick='async () => await Loc.SetLangAsync("ru")'>RU</button>
                <button class="lang-btn @(Loc.CurrentLang == "ky" ? "active" : "")"
                        @onclick='async () => await Loc.SetLangAsync("ky")'>KG</button>
                <button class="lang-btn @(Loc.CurrentLang == "en" ? "active" : "")"
                        @onclick='async () => await Loc.SetLangAsync("en")'>EN</button>
            </div>
        </div>
        <button class="btn-logout" @onclick="async () => await Logout()">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/>
            </svg>
            <span>@Loc["btn.logout"]</span>
        </button>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnClose { get; set; }

    bool isAdmin => State.Auth?.RoleName == "admin";

    protected override void OnInitialized()
    {
        State.OnChange += StateHasChanged;
        Theme.OnChange += StateHasChanged;
        Loc.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        State.OnChange -= StateHasChanged;
        Theme.OnChange -= StateHasChanged;
        Loc.OnChange -= StateHasChanged;
    }

    async Task Navigate(string view)
    {
        State.Navigate(view);
        await OnClose.InvokeAsync();
    }

    async Task Logout()
    {
        try { await JS.InvokeVoidAsync("localStorage.removeItem", "kpp-auth"); } catch { }
        State.Logout();
    }
}
