@using KppBlazor.Layout.MainLayout
@using KppBlazor.Shared
@using KppBlazor.Services
@using KppBlazor.Models
@using System.Text.Json
@using KppBlazor.Pages
@inject ThemeService Theme
@inject LocalizationService Loc
@inject AppState State
@inject ApiService Api
@inject IJSRuntime JS
@inject NavigationManager Nav

@if (isLoginPage || State.Auth != null)
{
    <Router AppAssembly="typeof(App).Assembly">
        <Found Context="routeData">
            <RouteView RouteData="routeData" DefaultLayout="typeof(KppBlazor.Layout.MainLayout.MainLayout)" />
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>404</PageTitle>
            <LayoutView Layout="typeof(KppBlazor.Layout.MainLayout.MainLayout)">
                <div style="display:flex;align-items:center;justify-content:center;height:100vh;color:var(--text-muted);font-size:18px">
                    404 — Страница не найдена
                </div>
            </LayoutView>
        </NotFound>
    </Router>
}
else
{
    @* Не авторизован — показываем Login без сайдбара *@
    <LayoutView Layout="typeof(KppBlazor.Shared.NoLayout)">
        <Login />
    </LayoutView>
}

@code {
    bool isLoginPage = false;

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        UpdateCurrentPath();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Theme.InitializeAsync();
            await Loc.InitializeAsync();
            await RestoreAuthAsync();
            // После восстановления авторизации — проверяем SPA-редирект
            await HandleSpaRedirect();
        }
    }

    void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdateCurrentPath();
        StateHasChanged();
    }

    void UpdateCurrentPath()
    {
        var relativePath = Nav.ToBaseRelativePath(Nav.Uri);
        isLoginPage = relativePath == "login";
    }

    /// <summary>
    /// Для GitHub Pages: 404.html сохраняет запрошенный путь в sessionStorage,
    /// затем редиректит на корень. Здесь мы читаем путь и делаем NavigateTo.
    /// </summary>
    async Task HandleSpaRedirect()
    {
        try
        {
            var redirectPath = await JS.InvokeAsync<string?>("sessionStorage.getItem", "kpp-redirect");
            if (!string.IsNullOrEmpty(redirectPath))
            {
                await JS.InvokeVoidAsync("sessionStorage.removeItem", "kpp-redirect");
                Nav.NavigateTo(redirectPath, forceLoad: false);
            }
        }
        catch { }
    }

    async Task RestoreAuthAsync()
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", "kpp-auth");
            if (!string.IsNullOrEmpty(json))
            {
                var auth = JsonSerializer.Deserialize<AuthInfo>(json);
                if (auth != null && !string.IsNullOrEmpty(auth.Username))
                {
                    Api.SetAuth(auth);
                    State.SetAuth(auth);
                    if (auth.RoleName == RoleNames.Admin)
                        State.RolesCache = await Api.GetRolesAsync();
                }
            }
        }
        catch { }
    }
}
